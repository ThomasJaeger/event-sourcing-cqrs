  <!--
    Test-only migration sets for the two runners' version-ordering facts. The shipped
    migrations/ sets are contiguous and apply all-or-nothing, so neither state those facts
    need is reachable from them.

    Three logical sets per engine, and no set shares a file with another. A runner reads what
    is applied from the tracking table, so a follow-on set carries only the versions under
    test: an already-applied version in it would be filtered out as not pending and would add
    nothing but a checksum comparison these facts do not exercise.
      Sparse      0001, 0003  the applied baseline, highest applied 3
      BackFilled  0002        lands late, below the highest applied
      Forward     0004        lands above the highest applied
  -->
  <ItemGroup>
    <EmbeddedResource Include="Postgres\OrderingMigrations\0001_create_ordering_alpha.sql" LogicalName="Tests.OrderingMigrations.Postgres.Sparse.0001_create_ordering_alpha.sql" />
    <EmbeddedResource Include="Postgres\OrderingMigrations\0003_create_ordering_gamma.sql" LogicalName="Tests.OrderingMigrations.Postgres.Sparse.0003_create_ordering_gamma.sql" />
    <EmbeddedResource Include="Postgres\OrderingMigrations\0002_create_ordering_beta.sql" LogicalName="Tests.OrderingMigrations.Postgres.BackFilled.0002_create_ordering_beta.sql" />
    <EmbeddedResource Include="Postgres\OrderingMigrations\0004_create_ordering_delta.sql" LogicalName="Tests.OrderingMigrations.Postgres.Forward.0004_create_ordering_delta.sql" />
    <EmbeddedResource Include="SqlServer\OrderingMigrations\0001_create_ordering_alpha.sql" LogicalName="Tests.OrderingMigrations.SqlServer.Sparse.0001_create_ordering_alpha.sql" />
    <EmbeddedResource Include="SqlServer\OrderingMigrations\0003_create_ordering_gamma.sql" LogicalName="Tests.OrderingMigrations.SqlServer.Sparse.0003_create_ordering_gamma.sql" />
    <EmbeddedResource Include="SqlServer\OrderingMigrations\0002_create_ordering_beta.sql" LogicalName="Tests.OrderingMigrations.SqlServer.BackFilled.0002_create_ordering_beta.sql" />
    <EmbeddedResource Include="SqlServer\OrderingMigrations\0004_create_ordering_delta.sql" LogicalName="Tests.OrderingMigrations.SqlServer.Forward.0004_create_ordering_delta.sql" />
  </ItemGroup>
