@using EventSourcingCqrs.Application.Queries.Sales

<section aria-label="@($"{Label} order details")" class="story-recorded-state" data-moment="@Label">
    <div class="story-state-heading">
        <div class="story-section-heading"><p class="story-eyebrow">@Label</p><span class="story-state-step" aria-hidden="true">@Step.Version.ToString("D2")</span></div>
        <h2>Step @Step.Version</h2>
        <p class="story-state-description">@Step.Description</p>
        <p class="story-timestamp">@Step.OccurredUtc.ToString("dd MMM yyyy, HH:mm:ss 'UTC'")</p>
    </div>
    <dl class="story-state-facts">
        <div><dt>Status</dt><dd><span class="story-status" data-status="@Step.Snapshot.Status">@Step.Snapshot.Status</span></dd></div>
        <div><dt>Order total</dt><dd class="story-state-total">@Step.Total</dd></div>
        <div class="story-state-address"><dt>Shipping address</dt><dd>@OrderHistoryComparison.FormatAddress(Step.Snapshot.ShippingAddress)</dd></div>
    </dl>
    <h3 class="story-state-items-title">Items</h3>
    @if (Step.Snapshot.Lines.Count == 0)
    {
        <p class="story-help">No items at this step.</p>
    }
    else
    {
        <ul class="story-state-items">
            @foreach (var line in Step.Snapshot.Lines)
            {
                <li @key="line.LineId">
                    <div class="min-w-0"><p class="story-state-sku">@line.Sku</p><p class="story-help">@line.Quantity × @line.UnitPrice each</p></div>
                    <p class="story-state-subtotal">@line.Subtotal</p>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public OrderHistoryStep Step { get; set; } = null!;
}
