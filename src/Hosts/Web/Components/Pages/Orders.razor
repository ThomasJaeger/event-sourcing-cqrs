@page "/orders"
@using EventSourcingCqrs.Application.Queries.Sales
@using EventSourcingCqrs.Domain.Sales.ReadModels
@inject IApiClient ApiClient

<PageTitle>Orders</PageTitle>

<h1 class="text-2xl font-bold mb-4">Orders</h1>

@if (orders is null)
{
    <p class="text-gray-500">Loading...</p>
}
else if (orders.Count == 0)
{
    <p class="text-gray-500">No orders yet.</p>
}
else
{
    <table class="min-w-full border border-gray-300">
        <thead class="bg-gray-100">
            <tr>
                <th class="px-4 py-2 text-left">Order ID</th>
                <th class="px-4 py-2 text-left">Customer ID</th>
                <th class="px-4 py-2 text-left">Status</th>
                <th class="px-4 py-2 text-right">Total</th>
                <th class="px-4 py-2 text-left">Placed</th>
                <th class="px-4 py-2 text-left">Last Updated</th>
                <th class="px-4 py-2 text-left">Returned</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in orders)
            {
                <tr class="border-t border-gray-200">
                    <td class="px-4 py-2 font-mono text-sm">@row.OrderId</td>
                    <td class="px-4 py-2 font-mono text-sm">@row.CustomerId</td>
                    <td class="px-4 py-2">@row.Status</td>
                    <td class="px-4 py-2 text-right">@row.Total</td>
                    <td class="px-4 py-2">@row.PlacedUtc.ToString("u")</td>
                    <td class="px-4 py-2">@row.LastUpdatedUtc.ToString("u")</td>
                    <td class="px-4 py-2">@(row.IsReturned ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<OrderListRow>? orders;

    protected override async Task OnInitializedAsync()
    {
        orders = await ApiClient.QueryAsync(new ListOrders(0, 50), CancellationToken.None);
    }
}
