@page "/orders"
@using EventSourcingCqrs.Application.Queries.Sales
@using EventSourcingCqrs.Domain.Sales
@using EventSourcingCqrs.Domain.Sales.ReadModels
@inject IApiClient ApiClient

<PageTitle>Orders</PageTitle>

<div class="ops-page">
    <header class="ops-header">
        <div>
            <p class="ops-eyebrow">THE ORDER DESK</p>
            <div class="ops-title-row"><h1>Orders</h1></div>
            <p class="ops-intro">Big plans. Small details. Keep every order moving.</p>
        </div>
        <a href="/orders/new" class="ops-primary"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>New order</span></a>
    </header>

@if (orders is null)
{
    <p role="status" class="ops-loading">Loading your orders...</p>
}
else
{
    <section class="ops-summary" aria-labelledby="orders-page-summary">
        <div class="ops-section-heading">
            <h2 id="orders-page-summary"><span class="ops-section-number">01</span> On this page</h2>
            <p>Up to 50 orders. Counts describe this page only.</p>
        </div>
        <dl class="ops-metrics">
            <div class="ops-metric ops-metric-violet"><dt>Orders shown<span class="ops-metric-symbol" aria-hidden="true">↗</span></dt><dd>@orders.Count</dd><dd class="ops-metric-caption">Your current view</dd></div>
            <div class="ops-metric"><dt>Placed<span class="ops-metric-dot ops-dot-violet" aria-hidden="true"></span></dt><dd>@orders.Count(row => row.Status == OrderStatus.Placed)</dd><dd class="ops-metric-caption">Orders placed</dd></div>
            <div class="ops-metric"><dt>Shipped<span class="ops-metric-dot ops-dot-coral" aria-hidden="true"></span></dt><dd>@orders.Count(row => row.Status == OrderStatus.Shipped)</dd><dd class="ops-metric-caption">Marked as shipped</dd></div>
            <div class="ops-metric ops-metric-lime"><dt>Returned<span class="ops-metric-symbol" aria-hidden="true">↶</span></dt><dd>@orders.Count(row => row.IsReturned)</dd><dd class="ops-metric-caption">Returns recorded</dd></div>
        </dl>
    </section>

    <section class="ops-data-section" aria-labelledby="orders-table-heading">
        <div class="ops-section-heading">
            <h2 id="orders-table-heading"><span class="ops-section-number">02</span> The order list</h2>
            <p>Open an order for the full picture.</p>
        </div>
        @if (orders.Count == 0)
        {
            <div class="ops-empty">
                <span class="ops-empty-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3h10l3 5v13H4V8l3-5Z"/><path d="M4 8h16M9 12h6M9 16h4"/></svg></span>
                <h3>No orders yet.</h3>
                <p>Start with an item, add a destination, and take it from there.</p>
                <a href="/orders/new" class="ops-primary">Create an order</a>
            </div>
        }
        else
        {
            <div class="ops-table-card">
                <div class="ops-table-scroll" role="region" aria-label="Scrollable data table" tabindex="0">
                    <table class="ops-table">
                        <caption class="ops-sr-only">Loaded orders, with status, totals, and recorded dates in UTC.</caption>
                        <thead><tr>
                            <th scope="col">Order ID</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="ops-align-right">Total</th>
                            <th scope="col">Customer ID</th>
                            <th scope="col">Placed</th>
                            <th scope="col">Last Updated</th>
                            <th scope="col">Returned</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var row in orders)
                        {
                            <tr>
                                <td><a href="@($"/orders/{row.OrderId}")" aria-label="View order @row.OrderId" title="@row.OrderId" class="ops-id-link"><span class="ops-row-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3h10l3 5v13H4V8l3-5Z"/><path d="M4 8h16M9 12h6M9 16h4"/></svg></span><span class="ops-code">@row.OrderId</span></a></td>
                                <td><span class="ops-status" data-status="@row.Status">@row.Status</span></td>
                                <td class="ops-align-right ops-money">@row.Total</td>
                                <td><a href="@($"/customers/{row.CustomerId}")" aria-label="View customer @row.CustomerId" title="@row.CustomerId" class="ops-id-link ops-customer-link"><span class="ops-code">@row.CustomerId</span></a></td>
                                <td class="ops-date">@row.PlacedUtc.ToString("u")</td>
                                <td class="ops-date">@row.LastUpdatedUtc.ToString("u")</td>
                                <td><span class="@(row.IsReturned ? "ops-returned" : "ops-muted")">@(row.IsReturned ? "Yes" : "No")</span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <p class="ops-table-note"><span>Times shown in UTC. Full IDs are available on each link.</span><span class="ops-scroll-hint">Scroll to explore <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></p>
            </div>
        }
    </section>
}
</div>

@code {
    private IReadOnlyList<OrderListRow>? orders;

    protected override async Task OnInitializedAsync()
    {
        orders = await ApiClient.QueryAsync(new ListOrders(0, 50), CancellationToken.None);
    }
}
