@page "/orders/{OrderId:guid}"
@using EventSourcingCqrs.Application
@using EventSourcingCqrs.Application.Queries.Sales
@using EventSourcingCqrs.Domain.Sales
@using EventSourcingCqrs.Hosts.Web.Components
@using EventSourcingCqrs.Hosts.Web.Hubs
@inject IApiClient ApiClient
@inject TimeProvider TimeProvider
@inject ICircuitResourceSubscription Subscription
@implements IAsyncDisposable

<PageTitle>Order @OrderId</PageTitle>

<div class="order-story story-detail">
<nav aria-label="Breadcrumb" class="story-breadcrumb">
    <a href="/orders">Orders</a>
    <span aria-hidden="true">/</span><span>Order details</span>
</nav>
<header class="story-heading">
    <div class="min-w-0">
        <p class="story-eyebrow">The whole story, in one place</p>
        <h1 class="focus:outline-none">Order details <span class="story-order-id">@OrderId</span></h1>
    </div>
    @if (!loading && detail is not null)
    {
        <LiveBadge State="@liveness" />
    }
</header>

@if (loading)
{
    <p role="status" class="story-empty">Loading...</p>
}
else if (detail is null)
{
    <p class="story-empty">Order not found.</p>
}
else
{
    <section aria-label="Order summary" class="story-summary">
        <div class="story-summary-main">
            <div>
                <p class="story-eyebrow">Current status</p>
                <p class="story-status" data-status="@detail.Header.Status">@detail.Header.Status</p>
            </div>
            <div class="story-total">
                <p>Order total</p>
                <p class="story-amount">@(detail.Header.Total?.ToString() ?? "N/A")</p>
            </div>
            <svg class="story-parcel" viewBox="0 0 120 120" fill="none" aria-hidden="true" focusable="false">
                <circle cx="60" cy="60" r="57" fill="currentColor" opacity=".1" />
                <path d="M27 44 60 26l33 18v37L60 99 27 81V44Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                <path d="m27 44 33 18 33-18M60 62v37M43 35l33 18v17l-10 6V58" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
            </svg>
        </div>
        <div class="story-summary-meta">
            <div>
                <p class="story-label">Customer</p>
                <a href="@($"/customers/{detail.Header.CustomerId}")" class="story-customer-link">@detail.Header.CustomerId</a>
            </div>
            <div>
                <p class="story-label">Last Updated</p>
                <p class="story-timestamp">@detail.Header.LastUpdatedUtc.ToString("u")</p>
            </div>
        </div>
    </section>

    <div class="story-actions">
        <a href="@($"/orders/{OrderId}/history")" class="story-history-link">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 10a9 9 0 1 1 2 8M3 4v6h6m3-4v6l4 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>View order history</span><span aria-hidden="true">↗</span>
        </a>
        @if (detail.Header.Status == OrderStatus.Placed)
        {
            <div class="story-cancel">
                <CancelOrderButton @ref="cancelButton" OrderId="@detail.Header.OrderId" OnDispatched="OnCancelDispatched" />
            </div>
        }
    </div>

    <div class="story-detail-grid">
        <section class="story-items">
            <div class="story-section-heading"><h2>Line Items</h2><span class="story-count">@detail.Lines.Count @(detail.Lines.Count == 1 ? "item" : "items")</span></div>
            @if (detail.Lines.Count == 0)
            {
                <p class="story-empty">No line items.</p>
            }
            else
            {
                <div class="story-table" role="region" aria-label="Order line items" tabindex="0">
                    <table class="min-w-full whitespace-nowrap text-sm">
                        <thead>
                            <tr>
                                <th scope="col" class="text-left">SKU</th>
                                <th scope="col" class="text-right">Quantity</th>
                                <th scope="col" class="text-right">Unit Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in detail.Lines)
                            {
                                <tr>
                                    <td class="font-mono font-semibold">@line.Sku</td>
                                    <td class="text-right">@line.Quantity</td>
                                    <td class="text-right">@line.UnitPrice</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="story-activity">
            <div class="story-section-heading"><h2>Order activity</h2><span class="story-activity-mark" aria-hidden="true">↳</span></div>
            <ul class="story-timeline">
                @foreach (var entry in detail.Timeline)
                {
                    <li>
                        <span class="story-timeline-dot" aria-hidden="true"></span>
                        <p class="story-event-name">@OrderActivityLabels.For(entry.EventType)</p>
                        <p class="story-timestamp">@entry.OccurredUtc.ToString("u")</p>
                    </li>
                }
            </ul>
        </section>
    </div>
}
</div>

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDetailView? detail;
    private bool loading = true;
    private CancelOrderButton? cancelButton;
    private CancellationTokenSource? degradedCts;

    // Subscription liveness, decided once at the arm (ADR 0034): Connecting until StartAsync returns, then
    // Live, or NotLive when the arm fails. LiveBadge renders it beside the page heading.
    private LivenessState liveness = LivenessState.Connecting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);
        loading = false;
    }

    // Subscribe on the first interactive render, not OnInitializedAsync, so a prerender pass does not
    // double-subscribe (ADR 0032). The subscription authorizes through the Api gate, registers under the
    // order's resource id (the "D" form OrderDetailProjection's envelope uses), snapshots, and re-queries
    // authoritative state on every notification, marshalled onto the render thread.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await Subscription.StartAsync(
                SubscriptionResourceType.Order,
                OrderId.ToString(),
                ct => ApiClient.QueryAsync(new GetOrderDetail(OrderId), ct),
                ApplyAsync,
                render => InvokeAsync(render),
                CancellationToken.None);
            liveness = LivenessState.Live;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Cancellation reaching this arm is not a liveness verdict; teardown faulting the marshal
            // leg lands here. The arm sets nothing (ADR 0034).
        }
        catch (Exception)
        {
            // The arm failed (authorization, dispatcher, transport). The page keeps the
            // order it loaded in OnInitializedAsync and stays up; it is simply not live
            // until a reload. The cancel-scoped degraded timer does not surface this;
            // LiveBadge does, beside the page heading. Do not dispose, do not rethrow,
            // do not tear down the circuit.
            liveness = LivenessState.NotLive;
            StateHasChanged();
        }
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        detail = await ApiClient.QueryAsync(new GetOrderDetail(OrderId), ct);
    }

    // The snapshot and every notification land here, marshalled. A Cancelled read model settles the cancel:
    // it hides the button and disarms the degraded fallback.
    private Task ApplyAsync(OrderDetailView? view)
    {
        detail = view;
        if (detail?.Header.Status == OrderStatus.Cancelled)
        {
            degradedCts?.Cancel();
            cancelButton?.MarkSettled();
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    // The cancel was dispatched. Arm the degraded fallback: if the Cancelled notification does not arrive
    // within the window, surface the "taking longer" state. The subscription drives the happy-path settle
    // through ApplyAsync, which cancels this timer.
    private async Task OnCancelDispatched()
    {
        degradedCts?.Cancel();
        degradedCts = new CancellationTokenSource();
        var token = degradedCts.Token;
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(30), TimeProvider, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() => cancelButton?.MarkPollingTimeout());
    }

    public async ValueTask DisposeAsync()
    {
        degradedCts?.Cancel();
        degradedCts?.Dispose();
        await Subscription.DisposeAsync();
    }
}
