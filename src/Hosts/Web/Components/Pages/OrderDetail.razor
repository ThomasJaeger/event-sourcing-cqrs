@page "/orders/{OrderId:guid}"
@using EventSourcingCqrs.Application
@using EventSourcingCqrs.Application.Queries.Sales
@using EventSourcingCqrs.Domain.Sales
@using EventSourcingCqrs.Hosts.Web.Components
@using EventSourcingCqrs.Hosts.Web.Hubs
@inject IApiClient ApiClient
@inject TimeProvider TimeProvider
@inject ICircuitResourceSubscription Subscription
@implements IAsyncDisposable

<PageTitle>Order @OrderId</PageTitle>

<nav aria-label="Breadcrumb" class="mb-5 text-sm">
    <a href="/orders" class="rounded text-teal-800 underline underline-offset-4 hover:text-teal-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600">Orders</a>
    <span aria-hidden="true" class="mx-2 text-slate-400">/</span><span class="text-slate-600">Order details</span>
</nav>
<header class="mb-7">
    <div class="flex flex-wrap items-center gap-y-2">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950">Order details <span class="mt-2 block break-all font-mono text-sm font-normal tracking-normal text-slate-600">@OrderId</span></h1>
        @if (!loading && detail is not null)
        {
            <LiveBadge State="@liveness" />
        }
    </div>
</header>

@if (loading)
{
    <p role="status" class="rounded-xl border border-slate-200 bg-white p-6 text-slate-600">Loading...</p>
}
else if (detail is null)
{
    <p class="rounded-xl border border-slate-200 bg-white p-6 text-slate-600">Order not found.</p>
}
else
{
    <div class="mb-6 grid gap-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:grid-cols-2">
        <div>
            <p class="text-sm text-slate-600">Customer</p>
            <a href="@($"/customers/{detail.Header.CustomerId}")" class="break-all font-mono text-sm text-teal-800 underline underline-offset-4 hover:text-teal-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600">@detail.Header.CustomerId</a>
        </div>
        <div>
            <p class="text-sm text-slate-600">Status</p>
            <p class="font-semibold">@detail.Header.Status</p>
        </div>
        <div>
            <p class="text-sm text-slate-600">Total</p>
            <p>@(detail.Header.Total?.ToString() ?? "N/A")</p>
        </div>
        <div>
            <p class="text-sm text-slate-600">Last Updated</p>
            <p>@detail.Header.LastUpdatedUtc.ToString("u")</p>
        </div>
    </div>

    @if (detail.Header.Status == OrderStatus.Placed)
    {
        <div class="mb-6">
            <CancelOrderButton @ref="cancelButton" OrderId="@detail.Header.OrderId" OnDispatched="OnCancelDispatched" />
        </div>
    }

    <h2 class="mb-3 mt-8 text-lg font-semibold text-slate-950">Line Items</h2>
    @if (detail.Lines.Count == 0)
    {
        <p class="text-slate-600 mb-6">No line items.</p>
    }
    else
    {
        <div class="mb-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600" role="region" aria-label="Order line items" tabindex="0">
        <table class="min-w-full whitespace-nowrap text-sm">
            <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-600">
                <tr>
                    <th scope="col" class="px-5 py-4 text-left">SKU</th>
                    <th scope="col" class="px-5 py-4 text-right">Quantity</th>
                    <th scope="col" class="px-5 py-4 text-right">Unit Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in detail.Lines)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50">
                        <td class="px-5 py-4 font-mono text-sm">@line.Sku</td>
                        <td class="px-5 py-4 text-right">@line.Quantity</td>
                        <td class="px-5 py-4 text-right">@line.UnitPrice</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }

    <h2 class="mb-3 mt-8 text-lg font-semibold text-slate-950">Order activity</h2>
    <ul class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        @foreach (var entry in detail.Timeline)
        {
            <li class="border-l-2 border-teal-600 pl-4">
                <p class="font-semibold">@OrderActivityLabels.For(entry.EventType)</p>
                <p class="text-sm text-slate-600">@entry.OccurredUtc.ToString("u")</p>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public Guid OrderId { get; set; }

    private OrderDetailView? detail;
    private bool loading = true;
    private CancelOrderButton? cancelButton;
    private CancellationTokenSource? degradedCts;

    // Subscription liveness, decided once at the arm (ADR 0034): Connecting until StartAsync returns, then
    // Live, or NotLive when the arm fails. LiveBadge renders it beside the page heading.
    private LivenessState liveness = LivenessState.Connecting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);
        loading = false;
    }

    // Subscribe on the first interactive render, not OnInitializedAsync, so a prerender pass does not
    // double-subscribe (ADR 0032). The subscription authorizes through the Api gate, registers under the
    // order's resource id (the "D" form OrderDetailProjection's envelope uses), snapshots, and re-queries
    // authoritative state on every notification, marshalled onto the render thread.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await Subscription.StartAsync(
                SubscriptionResourceType.Order,
                OrderId.ToString(),
                ct => ApiClient.QueryAsync(new GetOrderDetail(OrderId), ct),
                ApplyAsync,
                render => InvokeAsync(render),
                CancellationToken.None);
            liveness = LivenessState.Live;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Cancellation reaching this arm is not a liveness verdict; teardown faulting the marshal
            // leg lands here. The arm sets nothing (ADR 0034).
        }
        catch (Exception)
        {
            // The arm failed (authorization, dispatcher, transport). The page keeps the
            // order it loaded in OnInitializedAsync and stays up; it is simply not live
            // until a reload. The cancel-scoped degraded timer does not surface this;
            // LiveBadge does, beside the page heading. Do not dispose, do not rethrow,
            // do not tear down the circuit.
            liveness = LivenessState.NotLive;
            StateHasChanged();
        }
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        detail = await ApiClient.QueryAsync(new GetOrderDetail(OrderId), ct);
    }

    // The snapshot and every notification land here, marshalled. A Cancelled read model settles the cancel:
    // it hides the button and disarms the degraded fallback.
    private Task ApplyAsync(OrderDetailView? view)
    {
        detail = view;
        if (detail?.Header.Status == OrderStatus.Cancelled)
        {
            degradedCts?.Cancel();
            cancelButton?.MarkSettled();
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    // The cancel was dispatched. Arm the degraded fallback: if the Cancelled notification does not arrive
    // within the window, surface the "taking longer" state. The subscription drives the happy-path settle
    // through ApplyAsync, which cancels this timer.
    private async Task OnCancelDispatched()
    {
        degradedCts?.Cancel();
        degradedCts = new CancellationTokenSource();
        var token = degradedCts.Token;
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(30), TimeProvider, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() => cancelButton?.MarkPollingTimeout());
    }

    public async ValueTask DisposeAsync()
    {
        degradedCts?.Cancel();
        degradedCts?.Dispose();
        await Subscription.DisposeAsync();
    }
}
