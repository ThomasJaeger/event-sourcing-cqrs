@page "/my-orders"
@using EventSourcingCqrs.Application
@using EventSourcingCqrs.Application.Queries.Sales
@using EventSourcingCqrs.Domain.Sales.ReadModels
@using EventSourcingCqrs.Hosts.Web.Authentication
@using EventSourcingCqrs.Hosts.Web.Hubs
@inject IApiClient ApiClient
@inject ICircuitResourceSubscription Subscription
@inject ICircuitForwardedIdentityProvider IdentityProvider
@implements IAsyncDisposable

<PageTitle>My Orders</PageTitle>

<div class="mb-3 flex flex-wrap items-center gap-y-2">
    <h1 class="text-3xl font-semibold tracking-tight text-slate-950">My Orders</h1>
    <LiveBadge State="@liveness" />
</div>
<p class="mb-7 text-sm leading-6 text-slate-600">Open an order to review its details and latest recorded status.</p>

@if (orders is null)
{
    <p role="status" class="rounded-xl border border-slate-200 bg-white p-6 text-slate-600">Loading...</p>
}
else if (orders.Count == 0)
{
    <div class="rounded-xl border border-dashed border-slate-300 bg-white px-6 py-10 text-center">
        <p class="font-semibold text-slate-800">No orders yet.</p>
        <p class="mt-2 text-sm text-slate-600">Orders available to your account will appear here.</p>
    </div>
}
else
{
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600" role="region" aria-label="Scrollable data table" tabindex="0">
    <table class="min-w-full whitespace-nowrap text-sm">
        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-600">
            <tr>
                <th scope="col" class="px-3 py-4 sm:px-5 text-left">Order</th>
                <th scope="col" class="px-3 py-4 sm:px-5 text-left">Status</th>
                <th scope="col" class="px-3 py-4 sm:px-5 text-right">Total</th>
                <th scope="col" class="px-3 py-4 sm:px-5 text-left">Placed</th>
                <th scope="col" class="px-3 py-4 sm:px-5 text-left">Last Updated</th>
                <th scope="col" class="px-3 py-4 sm:px-5 text-left">Returned</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in orders)
            {
                <tr class="border-t border-slate-100 hover:bg-slate-50">
                    <td class="px-3 py-4 sm:px-5 font-mono text-sm"><a href="@($"/orders/{row.OrderId}")" aria-label="View order @row.OrderId" title="@row.OrderId" class="block max-w-[6rem] truncate sm:max-w-[13rem] rounded text-teal-800 underline decoration-teal-300 underline-offset-4 hover:text-teal-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600">@row.OrderId</a></td>
                    <td class="px-3 py-4 sm:px-5">@row.Status</td>
                    <td class="px-3 py-4 sm:px-5 text-right">@row.Total</td>
                    <td class="px-3 py-4 sm:px-5">@row.PlacedUtc.ToString("u")</td>
                    <td class="px-3 py-4 sm:px-5">@row.LastUpdatedUtc.ToString("u")</td>
                    <td class="px-3 py-4 sm:px-5">@(row.IsReturned ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private IReadOnlyList<OrderListRow>? orders;

    // Subscription liveness, decided once at the arm (ADR 0034): Connecting until StartAsync returns, then
    // Live, or NotLive when the arm fails. LiveBadge renders it beside the page heading.
    private LivenessState liveness = LivenessState.Connecting;

    protected override async Task OnInitializedAsync()
    {
        orders = await ApiClient.QueryAsync(new ListOrders(0, 50), CancellationToken.None);
    }

    // Subscribe on the first interactive render, not OnInitializedAsync, so a prerender pass does
    // not double-subscribe (ADR 0032). The page subscribes under its own customer id, the actor-is-
    // customer convention (ADR 0037), so only this customer's order changes re-query. Every
    // notification re-queries the owner-scoped list, marshalled onto the render thread.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var actorId = await IdentityProvider.GetActorIdAsync();
            await Subscription.StartAsync(
                SubscriptionResourceType.CustomerOrders,
                actorId.ToString(),
                ct => ApiClient.QueryAsync(new ListOrders(0, 50), ct),
                ApplyAsync,
                render => InvokeAsync(render),
                CancellationToken.None);
            liveness = LivenessState.Live;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Cancellation reaching this arm is not a liveness verdict; teardown faulting the marshal
            // leg lands here. The arm sets nothing (ADR 0034).
        }
        catch (Exception)
        {
            // The arm failed (authorization, dispatcher, transport, or a circuit whose identity is
            // unavailable, which faults the actor resolve above). The page keeps its initial one-shot
            // data and stays up; it is simply not live until a reload. Do not dispose, do not rethrow,
            // do not tear down the circuit. LiveBadge surfaces this not-live state beside the heading.
            liveness = LivenessState.NotLive;
            StateHasChanged();
        }
    }

    // The snapshot and every notification land here, marshalled. The live feed is unconditional:
    // refresh the table from authoritative state.
    private async Task ApplyAsync(IReadOnlyList<OrderListRow>? list)
    {
        orders = list;
        StateHasChanged();
        await Task.CompletedTask;
    }

    // Safe whether or not the page ever armed: the subscription's DisposeAsync is a no-op before
    // any start and across repeated calls (ADR 0032).
    public async ValueTask DisposeAsync()
    {
        await Subscription.DisposeAsync();
    }
}
