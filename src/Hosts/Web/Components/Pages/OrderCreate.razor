@page "/orders/new"
@using EventSourcingCqrs.Application.Commands.Sales
@using EventSourcingCqrs.Application.Queries.Sales
@using EventSourcingCqrs.Domain.Sales
@using EventSourcingCqrs.Domain.SharedKernel
@using EventSourcingCqrs.Hosts.Web.Components.OrderCreate
@inject IApiClient ApiClient
@inject TimeProvider TimeProvider
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>New Order</PageTitle>

<div class="container mx-auto px-4 py-6">
    <h1 class="text-2xl font-bold mb-6">New Order</h1>

    <nav aria-label="Wizard progress" class="mb-6">
        <ol class="flex items-center space-x-4">
            @for (var step = 1; step <= StepLabels.Length; step++)
            {
                <li class="@(step == currentStep ? "font-bold text-blue-600" : "text-gray-400")">
                    <span class="text-sm">@step. @StepLabels[step - 1]</span>
                </li>
            }
        </ol>
    </nav>

    @switch (currentStep)
    {
        case 1:
            <CustomerStep OrderId="@orderId"
                          CustomerId="@customerId"
                          OnCustomerIdChanged="@(value => customerId = value)"
                          OnDispatched="@HandleCustomerStepDispatched" />
            break;
        case 2:
            <LineItemsStep OrderId="@orderId"
                           LineItems="@lineItems"
                           IsDispatching="@isDispatchingLine"
                           FailureMessage="@lineFailureMessage"
                           CanContinue="@(lineItems.Count >= 1)"
                           OnAddLine="@HandleAddLine"
                           OnRemoveLine="@HandleRemoveLine"
                           OnContinue="@(() => currentStep = 3)" />
            break;
        case 3:
            <ShippingAddressStep OrderId="@orderId"
                                 Address="@shippingAddress"
                                 OnAddressChanged="@(value => shippingAddress = value)"
                                 OnContinue="@(() => currentStep = 4)" />
            break;
        case 4:
            <ReviewAndPlaceStep OrderId="@orderId"
                                CustomerId="@customerId"
                                LineItems="@lineItems"
                                ShippingAddress="@shippingAddress"
                                BadgeState="@placeBadgeState"
                                BadgeMessage="@placeMessage"
                                IsPlacing="@isPlacing"
                                FailureMessage="@placeFailureMessage"
                                OnPlace="@HandlePlaceOrder" />
            break;
    }

    @if (currentStep > 1)
    {
        <button type="button"
                class="mt-4 text-sm text-gray-600 hover:text-gray-800 underline"
                @onclick="() => currentStep -= 1">
            Back
        </button>
    }
</div>

@code {
    private static readonly string[] StepLabels = ["Customer", "Line items", "Shipping", "Review"];

    private int currentStep = 1;
    private readonly Guid orderId = Guid.NewGuid();
    private Guid customerId;
    private List<LineItem> lineItems = new();
    private Address? shippingAddress;

    private bool isDispatchingLine;
    private string? lineFailureMessage;

    private CancellationTokenSource? pollingCts;
    private BadgeState placeBadgeState = BadgeState.Idle;
    private string placeMessage = string.Empty;
    private bool isPlacing;
    private string? placeFailureMessage;

    private void HandleCustomerStepDispatched()
    {
        currentStep = 2;
    }

    // The line-item dispatches are page-owned (design call M.a): the page holds
    // the working line list and the LineId minting site (alongside OrderId), so
    // the step component stays a form that reports inputs back rather than holding
    // its own dispatch state. LineId is minted here per add, matching OrderId.
    private async Task HandleAddLine((string Sku, int Quantity, Money UnitPrice) input)
    {
        isDispatchingLine = true;
        lineFailureMessage = null;
        var lineId = Guid.NewGuid();

        try
        {
            var command = new AddOrderLine(orderId, lineId, input.Sku, input.Quantity, input.UnitPrice);
            var idempotencyKey = Guid.NewGuid().ToString();
            await ApiClient.SendCommandAsync(command, idempotencyKey, CancellationToken.None);
            lineItems.Add(new LineItem(lineId, input.Sku, input.Quantity, input.UnitPrice));
        }
        catch (ApiValidationException ex)
        {
            lineFailureMessage = ex.Errors.Count > 0
                ? string.Join(" ", ex.Errors.SelectMany(kvp => kvp.Value))
                : (!string.IsNullOrWhiteSpace(ex.Message) && ex.Message != "The request was invalid.")
                    ? ex.Message
                    : "The line could not be added.";
        }
        catch (ApiBusinessRuleException ex)
        {
            lineFailureMessage = ex.Message;
        }
        catch (ApiConcurrencyException)
        {
            lineFailureMessage = "The order changed while you were editing. Please refresh and try again.";
        }
        catch (ApiInfrastructureException ex)
        {
            lineFailureMessage = $"The line could not be added: {ex.Message}";
        }
        finally
        {
            isDispatchingLine = false;
        }
    }

    private async Task HandleRemoveLine(Guid lineId)
    {
        isDispatchingLine = true;
        lineFailureMessage = null;

        try
        {
            var command = new RemoveOrderLine(orderId, lineId);
            var idempotencyKey = Guid.NewGuid().ToString();
            await ApiClient.SendCommandAsync(command, idempotencyKey, CancellationToken.None);
            lineItems.RemoveAll(li => li.LineId == lineId);
        }
        catch (ApiValidationException ex)
        {
            lineFailureMessage = ex.Errors.Count > 0
                ? string.Join(" ", ex.Errors.SelectMany(kvp => kvp.Value))
                : (!string.IsNullOrWhiteSpace(ex.Message) && ex.Message != "The request was invalid.")
                    ? ex.Message
                    : "The line could not be removed.";
        }
        catch (ApiBusinessRuleException ex)
        {
            lineFailureMessage = ex.Message;
        }
        catch (ApiConcurrencyException)
        {
            lineFailureMessage = "The order changed while you were editing. Please refresh and try again.";
        }
        catch (ApiInfrastructureException ex)
        {
            lineFailureMessage = $"The line could not be removed: {ex.Message}";
        }
        finally
        {
            isDispatchingLine = false;
        }
    }

    // PlaceOrder is the wizard's final dispatch. It transitions the badge to
    // Pending optimistically, then polls GetOrderDetail for the Draft-to-Placed
    // status flip (D6); the PM cascade downstream of OrderPlaced surfaces at the
    // order-detail page the poll redirects to. Page-owned to match the line
    // dispatches, since the polling loop owns the page's TimeProvider and disposal.
    private async Task HandlePlaceOrder()
    {
        placeFailureMessage = null;
        placeBadgeState = BadgeState.Pending;
        placeMessage = "Placing order...";
        isPlacing = true;

        try
        {
            var command = new PlaceOrder(orderId);
            var idempotencyKey = Guid.NewGuid().ToString();
            await ApiClient.SendCommandAsync(command, idempotencyKey, CancellationToken.None);

            pollingCts?.Cancel();
            pollingCts?.Dispose();
            pollingCts = new CancellationTokenSource();
            _ = StartPlacePolling(pollingCts.Token);
        }
        catch (ApiValidationException ex)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = ex.Errors.Count > 0
                ? string.Join(" ", ex.Errors.SelectMany(kvp => kvp.Value))
                : (!string.IsNullOrWhiteSpace(ex.Message) && ex.Message != "The request was invalid.")
                    ? ex.Message
                    : "The order could not be placed.";
            isPlacing = false;
        }
        catch (ApiBusinessRuleException ex)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = ex.Message;
            isPlacing = false;
        }
        catch (ApiConcurrencyException)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = "The order changed while you were placing it. Please refresh and try again.";
            isPlacing = false;
        }
        catch (ApiInfrastructureException ex)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = $"The order could not be placed: {ex.Message}";
            isPlacing = false;
        }
    }

    // Mirrors OrderDetail.razor's StartPolling: 1-second TimeProvider-driven
    // delays, a 30-second deadline, a five-retry cap on transient read failures,
    // and OperationCanceled exit on disposal. On the Status flip to Placed it
    // settles the badge and redirects to the order-detail page (N.a), where the
    // user watches the PM cascade unfold.
    private async Task StartPlacePolling(CancellationToken token)
    {
        var deadline = TimeProvider.GetUtcNow().AddSeconds(30);
        var transientFailures = 0;

        while (!token.IsCancellationRequested && TimeProvider.GetUtcNow() < deadline)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(1), TimeProvider, token);
                var detail = await ApiClient.QueryAsync(new GetOrderDetail(orderId), token);
                transientFailures = 0;

                if (detail?.Header.Status == OrderStatus.Placed)
                {
                    placeBadgeState = BadgeState.Settled;
                    placeMessage = "Order placed.";
                    await InvokeAsync(StateHasChanged);
                    NavigationManager.NavigateTo($"/orders/{orderId}");
                    return;
                }
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (ApiInfrastructureException)
            {
                transientFailures++;
                if (transientFailures >= 5)
                {
                    placeBadgeState = BadgeState.Failed;
                    placeFailureMessage = "The order detail could not be retrieved. The order may still have been placed; check the orders list.";
                    isPlacing = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }
        }

        // The 30-second window elapsed without the status flipping to Placed.
        if (!token.IsCancellationRequested)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = "Placing the order is taking longer than expected. The order may still be processing; check the orders list.";
            isPlacing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        pollingCts?.Cancel();
        pollingCts?.Dispose();
        pollingCts = null;
        await Task.CompletedTask;
    }
}
