@page "/orders/new"
@using EventSourcingCqrs.Application
@using EventSourcingCqrs.Application.Commands.Sales
@using EventSourcingCqrs.Application.Queries.Sales
@using EventSourcingCqrs.Domain.Sales
@using EventSourcingCqrs.Domain.SharedKernel
@using EventSourcingCqrs.Hosts.Web.Components.OrderCreate
@using EventSourcingCqrs.Hosts.Web.Hubs
@inject IApiClient ApiClient
@inject TimeProvider TimeProvider
@inject NavigationManager NavigationManager
@inject ICircuitResourceSubscription Subscription
@implements IAsyncDisposable

<PageTitle>New Order</PageTitle>

<div class="order-story story-create">
<nav aria-label="Breadcrumb" class="story-breadcrumb">
    <a href="/orders">Orders</a><span aria-hidden="true">/</span><span>New order</span>
</nav>
<header class="story-create-hero">
    <div class="min-w-0">
        <p class="story-eyebrow">Good things start here</p>
        <h1 class="focus:outline-none">New Order</h1>
        <p class="story-intro">Add the customer, line items, and shipping address, then review your order.</p>
    </div>
    <svg class="story-create-art" viewBox="0 0 160 140" fill="none" aria-hidden="true" focusable="false">
        <circle cx="80" cy="70" r="61" fill="#f8f5ef" opacity=".55" />
        <path d="m43 50 37-20 37 20v42l-37 20-37-20V50Z" fill="#f8f5ef" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
        <path d="m43 50 37 20 37-20M80 70v42M60 41l37 20v17l-11 6V67" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
        <path d="M127 23v14m-7-7h14M28 96v12m-6-6h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        <circle cx="32" cy="29" r="4" fill="#6946df" /><circle cx="131" cy="106" r="5" fill="#d8ee8d" />
    </svg>
</header>
<div class="story-wizard">
    <nav aria-label="Wizard progress" class="story-wizard-progress">
        <ol>
            @for (var step = 1; step <= StepLabels.Length; step++)
            {
                <li aria-current="@(step == currentStep ? "step" : null)" class="@(step == currentStep ? "story-wizard-step is-current" : "story-wizard-step")">
                    <span class="story-wizard-number" aria-hidden="true">@step.ToString("D2")</span>
                    <span>@StepLabels[step - 1]</span>
                </li>
            }
        </ol>
    </nav>
    <div class="story-wizard-layout">
        <aside class="story-wizard-note">
            <p class="story-eyebrow">Step @currentStep of @StepLabels.Length</p>
            <p class="story-wizard-prompt">@(currentStep switch { 1 => "Who is it for?", 2 => "What goes inside?", 3 => "Where is it going?", _ => "Give it one last look." })</p>
            <p>@(currentStep switch { 1 => "Choose the customer to start an order draft.", 2 => "Add the items and quantities for this order.", 3 => "Save the address for this order.", _ => "Check the details before you place the order." })</p>
            <span class="story-wizard-flourish" aria-hidden="true">↘</span>
        </aside>
        <div class="story-wizard-body">
    @switch (currentStep)
    {
        case 1:
            <CustomerStep OrderId="@orderId"
                          CustomerId="@customerId"
                          OnCustomerIdChanged="@(value => customerId = value)"
                          OnDispatched="@HandleCustomerStepDispatched" />
            break;
        case 2:
            <LineItemsStep OrderId="@orderId"
                           LineItems="@lineItems"
                           IsDispatching="@isDispatchingLine"
                           FailureMessage="@lineFailureMessage"
                           CanContinue="@(lineItems.Count >= 1)"
                           OnAddLine="@HandleAddLine"
                           OnRemoveLine="@HandleRemoveLine"
                           OnContinue="@(() => currentStep = 3)" />
            break;
        case 3:
            <ShippingAddressStep OrderId="@orderId"
                                 Address="@shippingAddress"
                                 OnAddressChanged="@(value => shippingAddress = value)"
                                 OnContinue="@(() => currentStep = 4)" />
            break;
        case 4:
            <ReviewAndPlaceStep OrderId="@orderId"
                                CustomerId="@customerId"
                                LineItems="@lineItems"
                                ShippingAddress="@shippingAddress"
                                BadgeState="@placeBadgeState"
                                BadgeMessage="@placeMessage"
                                IsPlacing="@isPlacing"
                                FailureMessage="@placeFailureMessage"
                                Liveness="@liveness"
                                OnPlace="@HandlePlaceOrder" />
            break;
    }

    @if (currentStep > 1)
    {
        <button type="button"
                class="mt-4 text-sm text-slate-600 hover:text-slate-800 underline min-h-11 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2"
                @onclick="() => currentStep -= 1">
            Back
        </button>
    }
        </div>
    </div>
</div>
</div>

@code {
    private static readonly string[] StepLabels = ["Customer", "Line items", "Shipping", "Review"];

    private int currentStep = 1;
    private readonly Guid orderId = Guid.NewGuid();
    private Guid customerId;
    private List<LineItem> lineItems = new();
    private Address? shippingAddress;

    private bool isDispatchingLine;
    private string? lineFailureMessage;

    private CancellationTokenSource? degradedCts;

    // Subscription liveness, decided once at the PlaceOrder arm (ADR 0034): Idle until a place dispatches,
    // Connecting through the arm, then Live or NotLive. ReviewAndPlaceStep renders it via LiveBadge.
    private LivenessState liveness = LivenessState.Idle;
    private bool placedSettled;
    private BadgeState placeBadgeState = BadgeState.Idle;
    private string placeMessage = string.Empty;
    private bool isPlacing;
    private string? placeFailureMessage;

    private void HandleCustomerStepDispatched()
    {
        currentStep = 2;
    }

    // The line-item dispatches are page-owned (design call M.a): the page holds
    // the working line list and the LineId minting site (alongside OrderId), so
    // the step component stays a form that reports inputs back rather than holding
    // its own dispatch state. LineId is minted here per add, matching OrderId.
    private async Task HandleAddLine((string Sku, int Quantity, Money UnitPrice) input)
    {
        isDispatchingLine = true;
        lineFailureMessage = null;
        var lineId = Guid.NewGuid();

        try
        {
            var command = new AddOrderLine(orderId, lineId, input.Sku, input.Quantity, input.UnitPrice);
            var idempotencyKey = Guid.NewGuid().ToString();
            await ApiClient.SendCommandAsync(command, idempotencyKey, CancellationToken.None);
            lineItems.Add(new LineItem(lineId, input.Sku, input.Quantity, input.UnitPrice));
        }
        catch (ApiValidationException ex)
        {
            lineFailureMessage = ex.Errors.Count > 0
                ? string.Join(" ", ex.Errors.SelectMany(kvp => kvp.Value))
                : (!string.IsNullOrWhiteSpace(ex.Message) && ex.Message != "The request was invalid.")
                    ? ex.Message
                    : "The line could not be added.";
        }
        catch (ApiBusinessRuleException ex)
        {
            lineFailureMessage = ex.Message;
        }
        catch (ApiConcurrencyException)
        {
            lineFailureMessage = "The order changed while you were editing. Please refresh and try again.";
        }
        catch (ApiInfrastructureException ex)
        {
            lineFailureMessage = $"The line could not be added: {ex.Message}";
        }
        finally
        {
            isDispatchingLine = false;
        }
    }

    private async Task HandleRemoveLine(Guid lineId)
    {
        isDispatchingLine = true;
        lineFailureMessage = null;

        try
        {
            var command = new RemoveOrderLine(orderId, lineId);
            var idempotencyKey = Guid.NewGuid().ToString();
            await ApiClient.SendCommandAsync(command, idempotencyKey, CancellationToken.None);
            lineItems.RemoveAll(li => li.LineId == lineId);
        }
        catch (ApiValidationException ex)
        {
            lineFailureMessage = ex.Errors.Count > 0
                ? string.Join(" ", ex.Errors.SelectMany(kvp => kvp.Value))
                : (!string.IsNullOrWhiteSpace(ex.Message) && ex.Message != "The request was invalid.")
                    ? ex.Message
                    : "The line could not be removed.";
        }
        catch (ApiBusinessRuleException ex)
        {
            lineFailureMessage = ex.Message;
        }
        catch (ApiConcurrencyException)
        {
            lineFailureMessage = "The order changed while you were editing. Please refresh and try again.";
        }
        catch (ApiInfrastructureException ex)
        {
            lineFailureMessage = $"The line could not be removed: {ex.Message}";
        }
        finally
        {
            isDispatchingLine = false;
        }
    }

    // PlaceOrder is the wizard's final dispatch. It transitions the badge to Pending optimistically, then
    // arms a live wait on the order-detail projection (ADR 0032): a degraded timer that surfaces the failed
    // badge at the 30-second deadline, plus the circuit subscription that watches for the Draft-to-Placed
    // flip and settles in ApplyAsync. The PM cascade downstream of OrderPlaced surfaces at the order-detail
    // page the settle redirects to.
    private async Task HandlePlaceOrder()
    {
        placeFailureMessage = null;
        placeBadgeState = BadgeState.Pending;
        placeMessage = "Placing order...";
        isPlacing = true;

        try
        {
            var command = new PlaceOrder(orderId);
            var idempotencyKey = Guid.NewGuid().ToString();
            await ApiClient.SendCommandAsync(command, idempotencyKey, CancellationToken.None);
        }
        catch (ApiValidationException ex)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = ex.Errors.Count > 0
                ? string.Join(" ", ex.Errors.SelectMany(kvp => kvp.Value))
                : (!string.IsNullOrWhiteSpace(ex.Message) && ex.Message != "The request was invalid.")
                    ? ex.Message
                    : "The order could not be placed.";
            isPlacing = false;
            return;
        }
        catch (ApiBusinessRuleException ex)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = ex.Message;
            isPlacing = false;
            return;
        }
        catch (ApiConcurrencyException)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = "The order changed while you were placing it. Please refresh and try again.";
            isPlacing = false;
            return;
        }
        catch (ApiInfrastructureException ex)
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = $"The order could not be placed: {ex.Message}";
            isPlacing = false;
            return;
        }

        // Dispatch accepted. Arm the degraded timer first and independently of the subscription, so the
        // deadline still surfaces the failed badge even if the arm below throws. The subscription registers
        // under the order's default-form id, the "D" form OrderDetailProjection's envelope emits, matching
        // OrderDetail's subscriber.
        ArmDegradedTimer();
        liveness = LivenessState.Connecting;
        try
        {
            await Subscription.StartAsync(
                SubscriptionResourceType.Order,
                orderId.ToString(),
                ct => ApiClient.QueryAsync(new GetOrderDetail(orderId), ct),
                ApplyAsync,
                render => InvokeAsync(render),
                CancellationToken.None);
            liveness = LivenessState.Live;
        }
        catch (OperationCanceledException)
        {
            // Cancellation reaching this arm is not a liveness verdict; teardown faulting the marshal
            // leg lands here. The arm sets nothing (ADR 0034).
        }
        catch (Exception)
        {
            // The arm failed (authorization, dispatcher, transport). The order itself was already accepted,
            // so leave the subscription in place and the degraded timer armed: the deadline stays the
            // dispatch-outcome authority while LiveBadge surfaces the liveness loss. Do not dispose, do not
            // rethrow, do not tear down the page.
            liveness = LivenessState.NotLive;
        }
    }

    // The initial snapshot and every push land here, marshalled. On the Draft-to-Placed flip the wait is
    // over: settle the badge, disarm the degraded timer, dispose the subscription to close the delivery path
    // at the source, then navigate to the order-detail page where the user watches the PM cascade unfold.
    // The placedSettled guard makes this idempotent: a second, in-flight push after the terminal one neither
    // re-navigates nor throws on the navigating-away page (the already-terminal backstop).
    private async Task ApplyAsync(OrderDetailView? view)
    {
        if (placedSettled)
        {
            return;
        }
        if (view?.Header.Status == OrderStatus.Placed)
        {
            placedSettled = true;
            placeBadgeState = BadgeState.Settled;
            placeMessage = "Order placed.";
            isPlacing = false;
            degradedCts?.Cancel();
            StateHasChanged();
            await Subscription.DisposeAsync();
            NavigationManager.NavigateTo($"/orders/{orderId}");
        }
    }

    // Arms the degraded fallback for the live wait. Cancel-and-reassign mirrors OrderDetail; the final token
    // source is disposed in DisposeAsync. The background run is cancelled on the settling push (ApplyAsync)
    // and on page teardown (DisposeAsync), so its lifecycle is owned, not fire-and-forget.
    private void ArmDegradedTimer()
    {
        degradedCts?.Cancel();
        degradedCts = new CancellationTokenSource();
        _ = RunDegradedTimerAsync(degradedCts.Token);
    }

    // If the Placed push does not arrive within the window, surface the "taking longer than expected" failed
    // badge. The order may still be processing; the user is pointed at the orders list.
    private async Task RunDegradedTimerAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(30), TimeProvider, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() =>
        {
            placeBadgeState = BadgeState.Failed;
            placeFailureMessage = "Placing the order is taking longer than expected. The order may still be processing; check the orders list.";
            isPlacing = false;
            StateHasChanged();
        });
    }

    // Idempotent and safe whether or not the page ever armed: degradedCts is null until PlaceOrder, and the
    // subscription's DisposeAsync is a no-op before any start and across repeated calls (ADR 0032).
    public async ValueTask DisposeAsync()
    {
        degradedCts?.Cancel();
        degradedCts?.Dispose();
        await Subscription.DisposeAsync();
    }
}
