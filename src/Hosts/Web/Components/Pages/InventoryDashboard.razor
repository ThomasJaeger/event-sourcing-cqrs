@page "/inventory"
@using EventSourcingCqrs.Application.Commands.Fulfillment
@using EventSourcingCqrs.Application.Queries.Fulfillment
@using EventSourcingCqrs.Domain.Fulfillment.ReadModels
@using EventSourcingCqrs.Hosts.Web.Components.Inventory
@inject IApiClient ApiClient
@inject TimeProvider TimeProvider
@implements IAsyncDisposable

<PageTitle>Inventory</PageTitle>

<div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">Inventory</h1>
    <button id="createInventoryButton"
            type="button"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded"
            @onclick="OpenCreateDialog">
        Create Inventory
    </button>
</div>

@if (opBadge != BadgeState.Idle)
{
    <div class="mb-4">
        <PendingBadge State="@opBadge" Message="@opBadgeMessage" />
        @if (opBadge == BadgeState.Failed && opFailureMessage is not null)
        {
            <p class="text-sm text-red-700 mt-1">@opFailureMessage</p>
        }
    </div>
}

@if (rows is null)
{
    <p class="text-gray-500">Loading...</p>
}
else if (rows.Count == 0)
{
    <p class="text-gray-500">No inventory yet.</p>
}
else
{
    <table class="min-w-full border border-gray-300">
        <thead class="bg-gray-100">
            <tr>
                <th class="px-4 py-2 text-left">SKU</th>
                <th class="px-4 py-2 text-right">On Hand</th>
                <th class="px-4 py-2 text-right">Reserved</th>
                <th class="px-4 py-2 text-left">Last Updated</th>
                <th class="px-4 py-2 text-left">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr class="border-t border-gray-200">
                    <td class="px-4 py-2 font-mono text-sm">@row.Sku</td>
                    <td class="px-4 py-2 text-right">@row.OnHandQuantity</td>
                    <td class="px-4 py-2 text-right">@row.ReservedQuantity</td>
                    <td class="px-4 py-2">@row.LastUpdatedUtc.ToString("u")</td>
                    <td class="px-4 py-2">
                        <button class="adjust-button text-blue-600 hover:text-blue-800 underline"
                                type="button"
                                @onclick="() => OpenAdjustDialog(row)">
                            Adjust
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showCreateDialog)
{
    <CreateInventoryDialog OnSubmit="HandleCreate" OnCancel="CloseCreateDialog" />
}

@if (showAdjustDialog)
{
    <AdjustInventoryDialog Sku="@adjustSku"
                           CurrentOnHand="@adjustSnapshotOnHand"
                           OnSubmit="HandleAdjust"
                           OnCancel="CloseAdjustDialog" />
}

@code {
    private IReadOnlyList<InventoryDashboardRow>? rows;
    private bool showCreateDialog;
    private bool showAdjustDialog;
    private Guid adjustInventoryId;
    private string adjustSku = string.Empty;
    private int adjustSnapshotOnHand;

    // One optimistic operation is in flight at a time (the dialogs are modal), so
    // a single badge serves both Create and Adjust. opLabel names the operation so
    // the failed and timeout badges read "Create failed" / "Adjust failed".
    private string opLabel = string.Empty;
    private BadgeState opBadge = BadgeState.Idle;
    private string opBadgeMessage = string.Empty;
    private string? opFailureMessage;
    private CancellationTokenSource? pollingCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        rows = await ApiClient.QueryAsync(new GetAllInventoryDashboard(), ct);
    }

    private void OpenCreateDialog() => showCreateDialog = true;

    private void CloseCreateDialog() => showCreateDialog = false;

    // Snapshots the row's current on-hand at open time; the settle predicate adds
    // the dispatched delta to this snapshot rather than re-reading live.
    private void OpenAdjustDialog(InventoryDashboardRow row)
    {
        adjustInventoryId = row.InventoryId;
        adjustSku = row.Sku;
        adjustSnapshotOnHand = row.OnHandQuantity;
        showAdjustDialog = true;
    }

    private void CloseAdjustDialog() => showAdjustDialog = false;

    private async Task HandleCreate(string sku)
    {
        showCreateDialog = false;
        BeginOperation("Create", "Creating...");

        try
        {
            // A fresh InventoryId per click; the entered SKU is the only operator
            // input. Idempotency key minted at click time per ADR 0021.
            var command = new CreateInventory(Guid.NewGuid(), sku);
            await ApiClient.SendCommandAsync(command, Guid.NewGuid().ToString(), CancellationToken.None);

            // The new SKU's row appearing at all is the settled state.
            await StartPolling(sku, _ => true, "Created");
        }
        catch (ApiValidationException ex)
        {
            FailOperation(ValidationMessage(ex, "The create request was invalid."));
        }
        catch (ApiBusinessRuleException ex)
        {
            FailOperation(ex.Message);
        }
        catch (ApiConcurrencyException)
        {
            FailOperation("This inventory already exists. Refresh and try again.");
        }
        catch (ApiInfrastructureException)
        {
            FailOperation("Something went wrong. Try again.");
        }
    }

    private async Task HandleAdjust((int Delta, string Reason) input)
    {
        showAdjustDialog = false;
        var sku = adjustSku;
        var expectedOnHand = adjustSnapshotOnHand + input.Delta;
        var command = new AdjustInventory(adjustInventoryId, input.Delta, input.Reason);
        BeginOperation("Adjust", "Adjusting...");

        try
        {
            await ApiClient.SendCommandAsync(command, Guid.NewGuid().ToString(), CancellationToken.None);

            // The dashboard's on-hand reaching the snapshot-plus-delta target is the
            // settled state.
            await StartPolling(sku, row => row.OnHandQuantity == expectedOnHand, "Adjusted");
        }
        catch (ApiValidationException ex)
        {
            FailOperation(ValidationMessage(ex, "The adjustment was invalid."));
        }
        catch (ApiBusinessRuleException ex)
        {
            FailOperation(ex.Message);
        }
        catch (ApiConcurrencyException)
        {
            FailOperation("The inventory changed while you were adjusting it. Refresh and try again.");
        }
        catch (ApiInfrastructureException)
        {
            FailOperation("Something went wrong. Try again.");
        }
    }

    private void BeginOperation(string label, string pendingMessage)
    {
        opLabel = label;
        opBadge = BadgeState.Pending;
        opBadgeMessage = pendingMessage;
        opFailureMessage = null;
    }

    private void FailOperation(string failureMessage)
    {
        opBadge = BadgeState.Failed;
        opBadgeMessage = $"{opLabel} failed";
        opFailureMessage = failureMessage;
    }

    private static string ValidationMessage(ApiValidationException ex, string fallback)
    {
        var firstError = ex.Errors.SelectMany(e => e.Value).FirstOrDefault();
        return firstError
            ?? (string.IsNullOrWhiteSpace(ex.Message) || ex.Message == "The request was invalid."
                ? fallback
                : ex.Message);
    }

    // Delay-first polling for the read model to reflect the dispatched command,
    // matching OrderDetail.StartPolling: a 30-second deadline and a five-failure
    // transient cap on the read-side query. isSettled tests the fetched row (create
    // settles on any row appearing, adjust on the on-hand reaching its target). On
    // settlement the table refreshes in place; the operator stays on the dashboard
    // rather than redirecting.
    private async Task StartPolling(string sku, Func<InventoryDashboardRow, bool> isSettled, string settledMessage)
    {
        pollingCts?.Cancel();
        pollingCts = new CancellationTokenSource();
        var token = pollingCts.Token;

        var deadline = TimeProvider.GetUtcNow().AddSeconds(30);
        var transientFailures = 0;

        while (!token.IsCancellationRequested && TimeProvider.GetUtcNow() < deadline)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(1), TimeProvider, token);
                var row = await ApiClient.QueryAsync(new GetInventoryDashboardBySku(sku), token);
                transientFailures = 0;

                if (row is not null && isSettled(row))
                {
                    await LoadAsync(token);
                    opBadge = BadgeState.Settled;
                    opBadgeMessage = settledMessage;
                    StateHasChanged();
                    return;
                }
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (ApiInfrastructureException)
            {
                // Transient: keep polling up to a small retry limit before giving
                // up. The 30s deadline is the outer guard.
                transientFailures++;
                if (transientFailures >= 5)
                {
                    MarkPollingTimeout();
                    return;
                }
            }
        }

        // Deadline elapsed without the read model reaching the settled state.
        if (!token.IsCancellationRequested)
        {
            MarkPollingTimeout();
        }
    }

    private void MarkPollingTimeout()
    {
        opBadge = BadgeState.Failed;
        opBadgeMessage = $"{opLabel} may still be processing";
        opFailureMessage =
            "The command was accepted but is taking longer than expected. Refresh to check status.";
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        pollingCts?.Cancel();
        pollingCts?.Dispose();
        await Task.CompletedTask;
    }
}
