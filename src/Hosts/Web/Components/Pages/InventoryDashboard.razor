@page "/inventory"
@using EventSourcingCqrs.Application
@using EventSourcingCqrs.Application.Commands.Fulfillment
@using EventSourcingCqrs.Application.Queries.Fulfillment
@using EventSourcingCqrs.Domain.Abstractions
@using EventSourcingCqrs.Domain.Fulfillment.ReadModels
@using EventSourcingCqrs.Hosts.Web.Components.Inventory
@using EventSourcingCqrs.Hosts.Web.Hubs
@inject IApiClient ApiClient
@inject TimeProvider TimeProvider
@inject ICircuitResourceSubscription Subscription
@implements IAsyncDisposable

<PageTitle>Inventory</PageTitle>

<div class="flex items-center justify-between mb-4">
    <div class="flex items-center">
        <h1 class="text-2xl font-bold">Inventory</h1>
        <LiveBadge State="@liveness" />
    </div>
    <button id="createInventoryButton"
            type="button"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded"
            @onclick="OpenCreateDialog">
        Create Inventory
    </button>
</div>

@if (opBadge != BadgeState.Idle)
{
    <div class="mb-4">
        <PendingBadge State="@opBadge" Message="@opBadgeMessage" />
        @if (opBadge == BadgeState.Failed && opFailureMessage is not null)
        {
            <p class="text-sm text-red-700 mt-1">@opFailureMessage</p>
        }
    </div>
}

@if (rows is null)
{
    <p class="text-gray-500">Loading...</p>
}
else if (rows.Count == 0)
{
    <p class="text-gray-500">No inventory yet.</p>
}
else
{
    <table class="min-w-full border border-gray-300">
        <thead class="bg-gray-100">
            <tr>
                <th class="px-4 py-2 text-left">SKU</th>
                <th class="px-4 py-2 text-right">On Hand</th>
                <th class="px-4 py-2 text-right">Reserved</th>
                <th class="px-4 py-2 text-left">Last Updated</th>
                <th class="px-4 py-2 text-left">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr class="border-t border-gray-200">
                    <td class="px-4 py-2 font-mono text-sm">@row.Sku</td>
                    <td class="px-4 py-2 text-right">@row.OnHandQuantity</td>
                    <td class="px-4 py-2 text-right">@row.ReservedQuantity</td>
                    <td class="px-4 py-2">@row.LastUpdatedUtc.ToString("u")</td>
                    <td class="px-4 py-2">
                        <button class="adjust-button text-blue-600 hover:text-blue-800 underline"
                                type="button"
                                @onclick="() => OpenAdjustDialog(row)">
                            Adjust
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showCreateDialog)
{
    <CreateInventoryDialog OnSubmit="HandleCreate" OnCancel="CloseCreateDialog" />
}

@if (showAdjustDialog)
{
    <AdjustInventoryDialog Sku="@adjustSku"
                           CurrentOnHand="@adjustSnapshotOnHand"
                           OnSubmit="HandleAdjust"
                           OnCancel="CloseAdjustDialog" />
}

@code {
    private IReadOnlyList<InventoryDashboardRow>? rows;
    private bool showCreateDialog;
    private bool showAdjustDialog;
    private Guid adjustInventoryId;
    private string adjustSku = string.Empty;
    private int adjustSnapshotOnHand;

    // One optimistic operation is in flight at a time (the dialogs are modal), so
    // a single badge serves both Create and Adjust. opLabel names the operation so
    // the failed and timeout badges read "Create failed" / "Adjust failed".
    private string opLabel = string.Empty;
    private BadgeState opBadge = BadgeState.Idle;
    private string opBadgeMessage = string.Empty;
    private string? opFailureMessage;

    // The in-flight operation's settle predicate and outcome message, captured at
    // dispatch. The collection subscription re-queries the whole list on any
    // notification (it carries no per-operation context), then ApplyAsync tests
    // this predicate against the fresh list to settle the operation badge. Null
    // when no operation is awaiting a settle.
    private Func<IReadOnlyList<InventoryDashboardRow>, bool>? settlePredicate;
    private string opSettledMessage = string.Empty;

    // Per-operation degraded fallback. Armed on dispatch, cancelled on the settling
    // re-query and on page teardown, so the deadline surfaces the failed badge if no
    // settling notification arrives within the window.
    private CancellationTokenSource? degradedCts;

    // Subscription liveness, decided once at the arm (ADR 0034): Connecting until StartAsync returns, then
    // Live, or NotLive when the arm fails. LiveBadge renders it in the dashboard header.
    private LivenessState liveness = LivenessState.Connecting;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(CancellationToken.None);
    }

    // Subscribe on the first interactive render, not OnInitializedAsync, so a
    // prerender pass does not double-subscribe (ADR 0032). The InventoryDashboard is
    // a collection page over all SKUs, so it subscribes under the collection-scoped
    // sentinel and the projection emits the same sentinel (ADR 0033). Every
    // notification re-queries the whole list, marshalled onto the render thread.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await Subscription.StartAsync(
                SubscriptionResourceType.Inventory,
                CollectionResourceIds.AllInventory,
                ct => ApiClient.QueryAsync(new GetAllInventoryDashboard(), ct),
                ApplyAsync,
                render => InvokeAsync(render),
                CancellationToken.None);
            liveness = LivenessState.Live;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Cancellation reaching this arm is not a liveness verdict; teardown faulting the marshal
            // leg lands here. The arm sets nothing (ADR 0034).
        }
        catch (Exception)
        {
            // The arm failed (authorization, dispatcher, transport). The page keeps
            // its initial one-shot data and stays up; it is simply not live until a
            // reload. Do not dispose, do not rethrow, do not tear down the circuit.
            // LiveBadge surfaces this not-live state in the dashboard header.
            liveness = LivenessState.NotLive;
            StateHasChanged();
        }
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        rows = await ApiClient.QueryAsync(new GetAllInventoryDashboard(), ct);
    }

    // The snapshot and every notification land here, marshalled. The live feed is
    // unconditional: refresh the table from authoritative state. If an operation is
    // awaiting a settle, test its captured predicate against the fresh list, and on
    // a match settle the badge and disarm that operation's degraded fallback.
    private async Task ApplyAsync(IReadOnlyList<InventoryDashboardRow>? list)
    {
        rows = list;
        if (settlePredicate is not null && list is not null && settlePredicate(list))
        {
            settlePredicate = null;
            degradedCts?.Cancel();
            opBadge = BadgeState.Settled;
            opBadgeMessage = opSettledMessage;
        }
        StateHasChanged();
        await Task.CompletedTask;
    }

    private void OpenCreateDialog() => showCreateDialog = true;
    private void CloseCreateDialog() => showCreateDialog = false;

    // Snapshots the row's current on-hand at open time; the settle predicate adds
    // the dispatched delta to this snapshot rather than re-reading live.
    private void OpenAdjustDialog(InventoryDashboardRow row)
    {
        adjustInventoryId = row.InventoryId;
        adjustSku = row.Sku;
        adjustSnapshotOnHand = row.OnHandQuantity;
        showAdjustDialog = true;
    }

    private void CloseAdjustDialog() => showAdjustDialog = false;

    private async Task HandleCreate(string sku)
    {
        showCreateDialog = false;
        BeginOperation("Create", "Creating...");
        try
        {
            // A fresh InventoryId per click; the entered SKU is the only operator
            // input. Idempotency key minted at click time per ADR 0021.
            var command = new CreateInventory(Guid.NewGuid(), sku);
            await ApiClient.SendCommandAsync(command, Guid.NewGuid().ToString(), CancellationToken.None);
            // The new SKU's row appearing in the list is the settled state.
            ArmSettle(list => list.Any(r => r.Sku == sku), "Created");
        }
        catch (ApiValidationException ex)
        {
            FailOperation(ValidationMessage(ex, "The create request was invalid."));
        }
        catch (ApiBusinessRuleException ex)
        {
            FailOperation(ex.Message);
        }
        catch (ApiConcurrencyException)
        {
            FailOperation("This inventory already exists. Refresh and try again.");
        }
        catch (ApiInfrastructureException)
        {
            FailOperation("Something went wrong. Try again.");
        }
    }

    private async Task HandleAdjust((int Delta, string Reason) input)
    {
        showAdjustDialog = false;
        var sku = adjustSku;
        var expectedOnHand = adjustSnapshotOnHand + input.Delta;
        var command = new AdjustInventory(adjustInventoryId, input.Delta, input.Reason);
        BeginOperation("Adjust", "Adjusting...");
        try
        {
            await ApiClient.SendCommandAsync(command, Guid.NewGuid().ToString(), CancellationToken.None);
            // The dashboard's on-hand for this SKU reaching the snapshot-plus-delta
            // target is the settled state.
            ArmSettle(list => list.Any(r => r.Sku == sku && r.OnHandQuantity == expectedOnHand), "Adjusted");
        }
        catch (ApiValidationException ex)
        {
            FailOperation(ValidationMessage(ex, "The adjustment was invalid."));
        }
        catch (ApiBusinessRuleException ex)
        {
            FailOperation(ex.Message);
        }
        catch (ApiConcurrencyException)
        {
            FailOperation("The inventory changed while you were adjusting it. Refresh and try again.");
        }
        catch (ApiInfrastructureException)
        {
            FailOperation("Something went wrong. Try again.");
        }
    }

    private void BeginOperation(string label, string pendingMessage)
    {
        opLabel = label;
        opBadge = BadgeState.Pending;
        opBadgeMessage = pendingMessage;
        opFailureMessage = null;
    }

    // Captures the settle predicate for the in-flight operation and arms its degraded
    // fallback. The settling re-query (ApplyAsync) and page teardown (DisposeAsync)
    // both cancel the timer, so its lifecycle is owned, not fire-and-forget.
    private void ArmSettle(Func<IReadOnlyList<InventoryDashboardRow>, bool> predicate, string settledMessage)
    {
        settlePredicate = predicate;
        opSettledMessage = settledMessage;
        degradedCts?.Cancel();
        degradedCts = new CancellationTokenSource();
        _ = RunDegradedTimerAsync(degradedCts.Token);
    }

    private async Task RunDegradedTimerAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(30), TimeProvider, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await InvokeAsync(() =>
        {
            settlePredicate = null;
            opBadge = BadgeState.Failed;
            opBadgeMessage = $"{opLabel} may still be processing";
            opFailureMessage =
                "The command was accepted but is taking longer than expected. Refresh to check status.";
            StateHasChanged();
        });
    }

    private void FailOperation(string failureMessage)
    {
        opBadge = BadgeState.Failed;
        opBadgeMessage = $"{opLabel} failed";
        opFailureMessage = failureMessage;
    }

    private static string ValidationMessage(ApiValidationException ex, string fallback)
    {
        var firstError = ex.Errors.SelectMany(e => e.Value).FirstOrDefault();
        return firstError
            ?? (string.IsNullOrWhiteSpace(ex.Message) || ex.Message == "The request was invalid."
                ? fallback
                : ex.Message);
    }

    // Idempotent and safe whether or not the page ever armed: degradedCts is null
    // until an operation dispatches, and the subscription's DisposeAsync is a no-op
    // before any start and across repeated calls (ADR 0032).
    public async ValueTask DisposeAsync()
    {
        degradedCts?.Cancel();
        degradedCts?.Dispose();
        await Subscription.DisposeAsync();
    }
}
