@using EventSourcingCqrs.Domain.SharedKernel

<div>
    <h2 class="text-lg font-semibold mb-4">Review and place</h2>

    <dl class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
            <dt class="text-sm font-medium text-gray-600">Order ID</dt>
            <dd class="text-sm font-mono">@OrderId</dd>
        </div>
        @if (CustomerId != Guid.Empty)
        {
            <div>
                <dt class="text-sm font-medium text-gray-600">Customer ID</dt>
                <dd class="text-sm font-mono">@CustomerId</dd>
            </div>
        }
    </dl>

    @if (LineItems.Count > 0)
    {
        <div class="mb-4">
            <h3 class="text-sm font-medium text-gray-600 mb-2">Line items</h3>
            <ul>
                @foreach (var line in LineItems)
                {
                    <li class="text-sm">@line.Sku × @line.Quantity @@ @line.UnitPrice</li>
                }
            </ul>
        </div>
    }

    @if (ShippingAddress is not null)
    {
        <div class="mb-4">
            <h3 class="text-sm font-medium text-gray-600 mb-2">Shipping address</h3>
            <address class="text-sm not-italic">
                @ShippingAddress.Street<br />
                @ShippingAddress.City, @ShippingAddress.PostalCode<br />
                @ShippingAddress.Country
            </address>
        </div>
    }

    @if (!string.IsNullOrEmpty(FailureMessage))
    {
        <p class="text-sm text-red-600 mb-3">@FailureMessage</p>
    }

    <div class="flex items-center gap-3">
        <button id="placeOrderButton"
                type="button"
                class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded disabled:opacity-50 disabled:cursor-not-allowed"
                @onclick="HandlePlace"
                disabled="@(!CanPlace)">
            @(IsPlacing ? "Placing order..." : "Place order")
        </button>

        @if (BadgeState != BadgeState.Idle)
        {
            <PendingBadge State="@BadgeState" Message="@BadgeMessage" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Guid OrderId { get; set; }
    [Parameter, EditorRequired] public Guid CustomerId { get; set; }
    [Parameter, EditorRequired] public List<LineItem> LineItems { get; set; } = new();
    [Parameter] public Address? ShippingAddress { get; set; }
    [Parameter] public BadgeState BadgeState { get; set; } = BadgeState.Idle;
    [Parameter] public string BadgeMessage { get; set; } = string.Empty;
    [Parameter] public bool IsPlacing { get; set; }
    [Parameter] public string? FailureMessage { get; set; }
    [Parameter] public EventCallback OnPlace { get; set; }

    // Disabled while a place is in flight (Pending) or already settled, so the
    // operator cannot double-place; enabled on Idle or Failed so a failed place
    // can be retried.
    private bool CanPlace =>
        !IsPlacing
        && BadgeState != BadgeState.Pending
        && BadgeState != BadgeState.Settled;

    private Task HandlePlace() => OnPlace.InvokeAsync();
}
