@inherits LayoutComponentBase

<div class="workspace workspace-shell">
    <a href="#main-content" class="workspace-skip">Skip to content</a>
    <aside class="workspace-sidebar">
        <a href="/" class="workspace-brand" aria-label="Orders workspace home">
            <span class="workspace-brand-mark"><WorkspaceIcon Name="box" /></span>
            <span>orders<span class="workspace-brand-sub">workspace</span></span>
        </a>
        <p class="workspace-nav-label">Your everyday toolkit</p>
        <nav aria-label="Primary" class="workspace-nav">
            <NavLink href="/" Match="NavLinkMatch.All" class="workspace-nav-link" ActiveClass="is-active font-semibold"><WorkspaceIcon Name="grid" /><span>Overview</span></NavLink>
            <NavLink href="/orders" class="workspace-nav-link" ActiveClass="is-active font-semibold"><WorkspaceIcon Name="orders" /><span>Orders</span></NavLink>
            <NavLink href="/my-orders" class="workspace-nav-link" ActiveClass="is-active font-semibold"><WorkspaceIcon Name="person" /><span>My orders</span></NavLink>
            <NavLink href="/inventory" class="workspace-nav-link" ActiveClass="is-active font-semibold"><WorkspaceIcon Name="inventory" /><span>Inventory</span></NavLink>
            <NavLink href="/admin/throughput" class="workspace-nav-link" ActiveClass="is-active font-semibold"><WorkspaceIcon Name="pulse" /><span>Order activity</span></NavLink>
        </nav>
        <div class="workspace-sidebar-note" aria-hidden="true">
            <span class="workspace-note-star">✳</span>
            <p>Good things<br /><strong>start here.</strong></p>
            <span class="workspace-note-line"></span>
            <small>A little space to make things happen.</small>
        </div>
        <p class="workspace-sidebar-footer">A place for every order.</p>
    </aside>
    <div class="workspace-main-column">
        <header class="workspace-topbar">
            <span class="workspace-topbar-note"><span aria-hidden="true">✦</span> Make room for your next idea.</span>
            <div class="workspace-account-actions">
                <a href="/login" data-enhance-nav="false" class="workspace-account-link"><WorkspaceIcon Name="person" /><span>Account</span></a>
                <a href="/orders/new" class="workspace-button workspace-button-primary"><WorkspaceIcon Name="plus" /><span>New order</span></a>
            </div>
        </header>
        <main id="main-content" tabindex="-1" class="workspace-content">@Body</main>
        <footer class="workspace-footer"><span>Orders workspace</span><span>Every change has a place in the story. <span aria-hidden="true">↗</span></span></footer>
    </div>
</div>
