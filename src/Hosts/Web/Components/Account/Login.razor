@using EventSourcingCqrs.Hosts.Web.Components.Layout
@* The account endpoint renders this document directly, outside App and interactive Routes.
   Ordinary HTTP forms always use the requesting browser's current identity and antiforgery token. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Account | Orders workspace</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/workspace.css?v=20261007-studio" />
    <link rel="stylesheet" href="/operations.css?v=20261007-studio" />
    <link rel="stylesheet" href="/order-story.css?v=20261007-studio" />
</head>
<body class="bg-stone-50 font-sans antialiased">
<LayoutView Layout="typeof(MainLayout)">
    <div class="mx-auto max-w-lg rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
        <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-teal-800">Workspace access</p>
        <h1 class="mb-6 text-3xl font-semibold tracking-tight text-slate-950">Account</h1>
        @if (Error is not null)
        {
            <p role="alert" class="mb-6 rounded-lg bg-amber-50 p-4 text-sm leading-6 text-amber-900">@Error</p>
        }
        @if (ActorId is not null)
        {
            <p class="mb-6 break-words text-sm leading-6 text-slate-600">Signed in as <span class="break-all font-mono">@ActorId</span>.</p>
            <a href="/orders" class="mb-6 inline-block rounded text-teal-800 underline underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600">Continue to orders</a>
            <form method="post" action="/account/logout">
                <input type="hidden" name="@TokenFieldName" value="@Token" />
                <button type="submit" class="min-h-11 rounded-lg bg-teal-700 px-5 py-3 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">Sign out</button>
            </form>
        }
        else
        {
            <p class="mb-6 text-sm leading-6 text-slate-600">Enter the operator password to sign in.</p>
            <form method="post" action="/account/login">
                <input type="hidden" name="@TokenFieldName" value="@Token" />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <label for="operator-password" class="mb-2 block text-sm font-medium text-slate-800">Password</label>
                <input id="operator-password" name="password" type="password"
                       autocomplete="current-password" required maxlength="1024"
                       class="mb-6 block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-slate-950 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600" />
                <button type="submit" class="min-h-11 rounded-lg bg-teal-700 px-5 py-3 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">Sign in</button>
            </form>
        }
    </div>
</LayoutView>
</body>
</html>

@code {
    [Parameter] public string ReturnUrl { get; set; } = "/orders";
    [Parameter] public string? ActorId { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string TokenFieldName { get; set; } = string.Empty;
    [Parameter] public string Token { get; set; } = string.Empty;
}
