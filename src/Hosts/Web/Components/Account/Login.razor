@page "/login"
@using System.Security.Claims

<PageTitle>Account</PageTitle>

<div class="mx-auto max-w-lg rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
<p class="mb-2 text-xs font-semibold uppercase tracking-widest text-teal-800">Workspace access</p>
<h1 class="mb-6 text-3xl font-semibold tracking-tight text-slate-950">Account</h1>

@* Static SSR (no render mode): the sign-in and sign-out are plain form posts to the minimal-API
   account endpoints, which call SignInAsync/SignOutAsync. The forms carry an antiforgery token the
   endpoints validate. The framework seeds the circuit from the cookie the login sets. *@
<AuthorizeView>
    <Authorized>
        <p class="mb-6 break-words text-sm leading-6 text-slate-600">Signed in as @context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value.</p>
        <form method="post" action="/account/logout">
            <AntiforgeryToken />
            <button type="submit" class="min-h-11 rounded-lg bg-teal-700 px-5 py-3 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">Sign out</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <p class="mb-6 text-sm leading-6 text-slate-600">Enter the operator password to sign in.</p>
        <form method="post" action="/account/login">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label for="operator-password" class="mb-2 block text-sm font-medium text-slate-800">Password</label>
            <input id="operator-password" name="password" type="password"
                   autocomplete="current-password" required maxlength="1024"
                   class="mb-6 block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-slate-950 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600" />
            <button type="submit" class="min-h-11 rounded-lg bg-teal-700 px-5 py-3 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">Sign in</button>
        </form>
    </NotAuthorized>
</AuthorizeView>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
