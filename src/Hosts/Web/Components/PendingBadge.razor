@if (State == BadgeState.Pending)
{
    <span class="inline-flex items-center px-2 py-1 rounded text-sm bg-yellow-100 text-yellow-800 ml-2">
        <span class="inline-block w-2 h-2 bg-yellow-500 rounded-full animate-pulse mr-2"></span>
        @Message
    </span>
}
else if (State == BadgeState.Settled)
{
    <span class="inline-flex items-center px-2 py-1 rounded text-sm bg-green-100 text-green-800 ml-2">
        @Message
    </span>
}
else if (State == BadgeState.Failed)
{
    <span class="inline-flex items-center px-2 py-1 rounded text-sm bg-red-100 text-red-800 ml-2">
        @Message
    </span>
}

@code {
    [Parameter, EditorRequired] public BadgeState State { get; set; }
    [Parameter] public string Message { get; set; } = string.Empty;
}
