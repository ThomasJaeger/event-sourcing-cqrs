@* The first dialog pattern in Hosts.Web: a modal overlay rendered conditionally
   by the parent page. Presentation only: it collects a SKU and raises OnSubmit or
   OnCancel. The page owns the dispatch, polling, and badge state. *@

<div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-slate-950/60 p-4 py-8 sm:items-center">
    <div class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-xl">
        <h2 class="text-lg font-semibold mb-4">Create Inventory</h2>

        <label class="block text-sm font-medium text-slate-600 mb-1" for="skuInput">SKU</label>
        <input id="skuInput"
               type="text"
               class="w-full border border-slate-300 rounded px-3 py-2 mb-4 min-h-11 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2"
               @bind="sku"
               @bind:event="oninput" />

        <div class="flex justify-end gap-3">
            <button id="dialogCancelButton"
                    type="button"
                    class="px-4 py-2 rounded border border-slate-300 hover:bg-slate-100 min-h-11 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2"
                    @onclick="HandleCancel">
                Cancel
            </button>
            <button id="dialogCreateButton"
                    type="button"
                    class="bg-teal-700 hover:bg-teal-800 text-white px-4 py-2 rounded disabled:opacity-50 disabled:cursor-not-allowed min-h-11 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2"
                    @onclick="HandleSubmit"
                    disabled="@(!CanSubmit)">
                Create
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<string> OnSubmit { get; set; }
    [Parameter, EditorRequired] public EventCallback OnCancel { get; set; }

    private string sku = string.Empty;

    // Client gate mirroring the aggregate's non-empty-SKU rule; the server stays
    // the authority and a business-rule failure surfaces on the page's badge.
    private bool CanSubmit => !string.IsNullOrWhiteSpace(sku);

    private Task HandleSubmit() => OnSubmit.InvokeAsync(sku);

    private Task HandleCancel() => OnCancel.InvokeAsync();
}
