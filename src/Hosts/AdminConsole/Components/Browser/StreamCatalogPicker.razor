@using EventSourcingCqrs.Domain.Abstractions
@using EventSourcingCqrs.Hosts.AdminConsole.Browser
@implements IDisposable
@inject IEventCatalogReader Catalog
@inject EventCatalogAvailability Availability

<section aria-labelledby="stream-catalog-heading" class="mb-5 min-w-0 rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
    <h2 id="stream-catalog-heading" class="text-lg font-semibold text-slate-900">Choose a stream id</h2>
    @if (!Availability.IsAvailable)
    {
        <p class="mt-2 text-sm leading-6 text-slate-600">@Availability.UnavailableReason Enter an id below to continue.</p>
    }
    else
    {
        <p class="mt-2 text-sm leading-6 text-slate-600">All tenants. ID order, 25 per page. Aggregate streams only. Process-manager streams are excluded.</p>
        @if (loading)
        {
            <p role="status" class="py-6 text-sm text-slate-600">Loading stream ids...</p>
        }
        else if (error)
        {
            <div role="alert" class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
                <p>Unable to load the stream list. You can still enter an id below.</p>
                <button type="button" @onclick="RetryAsync" disabled="@Disabled" class="mt-3 rounded font-semibold underline underline-offset-4 disabled:opacity-50">Retry list</button>
            </div>
        }
        else if (items.Count == 0)
        {
            <p role="status" class="py-6 text-sm text-slate-600">No aggregate stream ids found. Enter a known id below or refresh the list.</p>
        }
        else
        {
            <ul aria-label="Available ids" class="mt-4 max-h-80 overflow-y-auto rounded-lg border border-slate-200 divide-y divide-slate-200">
                @foreach (var entry in items)
                {
                    <li @key="entry.StreamId">
                        <button type="button" data-catalog-id="@entry.StreamId" @onclick="() => SelectAsync(entry.StreamId)"
                                disabled="@(Disabled || loading)" aria-pressed="@(entry.StreamId.Equals(SelectedId) ? "true" : "false")"
                                class="block w-full px-3 py-3 text-left hover:bg-teal-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-teal-600 disabled:cursor-wait disabled:opacity-50 @(entry.StreamId.Equals(SelectedId) ? "bg-teal-50" : "bg-white")">
                            <span class="block break-all font-mono text-sm font-semibold text-teal-800">@entry.StreamId</span>
                            <span class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs leading-5 text-slate-600">
                                <span>@entry.EventCount @(entry.EventCount == 1 ? "event" : "events")</span>
                                <span>@entry.TenantCount @(entry.TenantCount == 1 ? "tenant" : "tenants")</span>
                                <span>Last occurred @entry.LastOccurredUtc.ToString("u")</span>
                            </span>
                        </button>
                    </li>
                }
            </ul>
        }
        <nav aria-label="stream catalog pages" class="mt-4 flex flex-wrap items-center gap-2 text-sm">
            <button type="button" @onclick="PreviousAsync" disabled="@(Disabled || loading || pageIndex == 0)" class="rounded-lg border border-slate-300 px-3 py-2 font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">Previous</button>
            <span class="px-1 text-slate-600">Page @(pageIndex + 1)</span>
            <button type="button" @onclick="NextAsync" disabled="@(Disabled || loading || error || !hasMore)" class="rounded-lg border border-slate-300 px-3 py-2 font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">Next</button>
            <button type="button" @onclick="RefreshAsync" disabled="@(Disabled || loading)" class="rounded-lg px-3 py-2 font-semibold text-teal-700 underline underline-offset-4 disabled:cursor-not-allowed disabled:opacity-40">Refresh list</button>
        </nav>
        <p class="mt-2 text-xs leading-5 text-slate-500">Refresh starts at the first page. New ids can appear before your current page.</p>
    }
</section>

@code {
    [Parameter] public EventCallback<string> Selected { get; set; }
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private readonly List<string?> cursors = [];
    private IReadOnlyList<StreamCatalogEntry> items = [];
    private string? retryCursor;
    private int retryIndex;
    private int pageIndex;
    private bool loading;
    private bool error;
    private bool hasMore;
    private bool disposed;

    protected override Task OnInitializedAsync()
        => Availability.IsAvailable ? LoadAsync(null, 0) : Task.CompletedTask;

    private Task SelectAsync(string id)
        => Disabled || loading || disposed ? Task.CompletedTask : Selected.InvokeAsync(id);
    private Task RefreshAsync() => LoadAsync(null, 0);
    private Task RetryAsync() => LoadAsync(retryCursor, retryIndex);
    private Task PreviousAsync()
        => pageIndex > 0 ? LoadAsync(cursors[pageIndex - 1], pageIndex - 1) : Task.CompletedTask;
    private Task NextAsync()
        => hasMore && !error && items.Count > 0 ? LoadAsync(items[^1].StreamId, pageIndex + 1) : Task.CompletedTask;

    private async Task LoadAsync(string? cursor, int index)
    {
        if (loading || Disabled || disposed || !Availability.IsAvailable) return;
        loading = true;
        error = false;
        retryCursor = cursor;
        retryIndex = index;
        try
        {
            var page = await Catalog.ListStreamsAsync(cursor, 25, lifetime.Token);
            if (disposed) return;
            items = page.Items;
            hasMore = page.HasMore;
            // Commit history only after a successful read. A failed Next retries its same cursor.
            if (index < cursors.Count) cursors.RemoveRange(index, cursors.Count - index);
            cursors.Add(cursor);
            pageIndex = index;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception)
        {
            if (!disposed) error = true;
        }
        finally
        {
            loading = false;
        }
    }

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
