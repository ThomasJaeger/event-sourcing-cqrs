@using EventSourcingCqrs.Application.Queries.Sales
<section data-order-state="@Side" class="min-w-0 rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
    <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">@Title</p>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
        <h3 class="text-xl font-semibold">Version @Step.Version</h3>
        <span class="rounded-full bg-teal-50 px-3 py-1 text-sm font-semibold text-teal-900">@Step.Snapshot.Status</span>
    </div>
    <p class="mt-3 break-words text-sm leading-6 text-slate-700">@Step.Description</p>
    <p class="mt-1 text-xs text-slate-500">Recorded event time: @Step.OccurredUtc.ToString("u")</p>
    <dl class="mt-5 space-y-3 text-sm">
        <div class="flex justify-between gap-4 border-t border-slate-100 pt-3"><dt class="text-slate-500">Order total</dt><dd class="text-lg font-semibold">@Step.Total</dd></div>
        <div><dt class="text-slate-500">Customer</dt><dd class="mt-1 break-all font-mono text-xs">@Step.Snapshot.CustomerId</dd></div>
        <div><dt class="text-slate-500">Shipping address</dt><dd class="mt-1 break-words">@(Step.Snapshot.ShippingAddress is {} address ? $"{address.Street}, {address.City}, {address.PostalCode}, {address.Country}" : "Not set at this version")</dd></div>
    </dl>
    <h4 class="mt-5 border-t border-slate-100 pt-4 text-sm font-semibold">Order items</h4>
    @if (Step.Snapshot.Lines.Count == 0)
    {
        <p class="mt-2 text-sm text-slate-500">No items at this version.</p>
    }
    else
    {
        <ul class="mt-2 divide-y divide-slate-100">
            @foreach (var line in Step.Snapshot.Lines)
            {
                <li class="flex flex-wrap justify-between gap-2 py-3 text-sm"><span class="min-w-0 break-all"><strong>@line.Sku</strong><br /><span class="text-slate-500">@line.Quantity × @line.UnitPrice</span></span><span class="font-semibold">@line.Subtotal</span></li>
            }
        </ul>
    }
</section>
@code {
    [Parameter, EditorRequired] public OrderHistoryStep Step { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Side { get; set; } = "";
}
