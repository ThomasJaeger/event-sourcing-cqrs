@implements IDisposable
@using Microsoft.JSInterop
@using EventSourcingCqrs.Hosts.AdminConsole.Components.Browser
@page "/correlations"
@using EventSourcingCqrs.Hosts.AdminConsole.Tracer
@inject ICorrelationTracer Tracer
@inject CorrelationTracerAvailability Availability

<PageTitle>Correlation-ID Tracer</PageTitle>

<h1 class="mb-3 break-words text-3xl font-bold tracking-tight text-slate-900">Correlation-ID Tracer</h1>

@if (Availability.IsAvailable)
{
    <CorrelationCatalogPicker Selected="OnSelectedAsync" SelectedId="@(Guid.TryParse(loadedId, out var selectedCorrelation) ? selectedCorrelation : (Guid?)null)" Disabled="@busy" />
    <div class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
        <p class="mb-5 max-w-3xl text-sm leading-6 text-slate-600">
            Or enter a known correlation id to trace one workflow. Every event carrying that id comes back in one list, across
            every stream and every tenant, oldest first, with the process manager's own rows beside the aggregate
            events that drove them.
        </p>

        <label class="block pb-4">
            <span class="block pb-2 text-sm font-semibold text-slate-800">Correlation id</span>
            <input @bind="correlationId" disabled="@busy"
                   class="block w-full max-w-2xl rounded-lg border border-slate-300 bg-white px-3 py-2.5 font-mono text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-200"
                   placeholder="0f8fad5b-07d0-4015-b9d0-63e8e9e7d6f8" />
        </label>

        <button type="button" @onclick="OnTraceAsync" disabled="@busy"
                class="rounded-lg bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
            Trace correlation
        </button>
    </div>
}
else
{
    @* The Correlation-ID Tracer is unavailable on this event store (KurrentDB has no cross-stream
       correlation-id index). The notice names the reason and the page renders no trace control, so the
       defense-in-depth throwing reader behind the seam is never reached. *@
    <div class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
        <p class="pb-4 font-medium text-red-700">Correlation tracing is not available on this deployment's event store.</p>
        <p class="mb-5 max-w-3xl text-sm leading-6 text-slate-600">@Availability.UnavailableReason</p>
    </div>
}

@if (loadedId is not null)
{
    <a href="@($"/audit?correlationId={Uri.EscapeDataString(loadedId)}")" class="mt-5 inline-block text-sm font-semibold text-teal-700 underline underline-offset-4">Open audit trail for this workflow</a>
    <h2 @ref="detailHeading" data-detail-heading tabindex="-1" class="mt-6 break-all text-lg font-semibold text-slate-900 focus:outline-none">Correlation events: <span class="font-mono text-base">@loadedId</span></h2>
}
@if (busy)
{
    <p role="status" class="mt-4 text-sm text-slate-600">Loading correlation events...</p>
}
else if (error)
{
    <p role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-800">Unable to trace the correlation id.</p>
}
else if (view is not null)
{
    @if (view.Outcome == CorrelationTraceOutcome.InvalidFormat)
    {
        <p role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-800">
            Enter a valid correlation id, for example 0f8fad5b-07d0-4015-b9d0-63e8e9e7d6f8.
        </p>
    }
    else if (view.Outcome == CorrelationTraceOutcome.SentinelRefused)
    {
        <p role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-800">
            The empty guid is a sentinel value, not a workflow identifier. The rows carrying it were written
            before correlation propagation reached the outbox route, so they are not traceable as a chain.
        </p>
    }
    else if (view.Outcome == CorrelationTraceOutcome.Empty)
    {
        <p role="status" class="mt-5 rounded-lg border border-slate-200 bg-white p-4 text-sm leading-6 text-slate-600">
            No events found for this correlation id. Verify the id, and that the workflow it belongs to ran
            against this database.
        </p>
    }
    else
    {
        @if (view.Truncated)
        {
            <p role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-800">
                This trace was cut at the row cap. The rows below are the earliest ones; reading the
                remainder needs a query tool.
            </p>
        }
        <div class="mt-6 min-w-0">
            @for (var i = 0; i < view.Events.Count; i++)
            {
                var index = i;
                var evt = view.Events[index];
                <div class="mb-5 min-w-0 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="flex flex-wrap gap-x-2 gap-y-1 break-all text-sm text-slate-600">
                        <span class="font-medium">@KindLabel(evt.Kind)</span>
                        <span class="pl-2">@evt.StreamId</span>
                        <span class="pl-2 font-medium">v@(evt.StreamVersion)</span>
                        <span class="pl-2 font-medium">@evt.EventType</span>
                        <span class="pl-2">schema @evt.EventVersion</span>
                        <span class="pl-2">@evt.OccurredUtc.ToString("u")</span>
                        <span class="pl-2">position @evt.GlobalPosition</span>
                        <span class="pl-2">tenant @evt.Metadata.Tenant.Value</span>
                    </div>
                    <pre class="mt-4 max-w-full overflow-x-auto rounded-lg bg-slate-950 p-4 font-mono text-xs leading-6 text-slate-100" tabindex="0" aria-label="Stored event payload">@evt.PayloadJson</pre>
                    <button type="button" @onclick="() => ToggleMetadata(index)"
                            aria-expanded="@(shownMetadata.Contains(index) ? "true" : "false")" aria-controls="event-metadata-@index" class="mt-4 rounded text-sm font-semibold text-teal-700 underline underline-offset-4 hover:text-teal-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-600">
                        @(shownMetadata.Contains(index) ? "Hide metadata" : "Show metadata")
                    </button>
                    @if (shownMetadata.Contains(index))
                    {
                        <dl id="event-metadata-@index" class="mt-4 space-y-2 break-all rounded-lg bg-slate-50 p-4 text-sm leading-6 text-slate-700">
                            <div><dt class="inline font-medium">Correlation id:</dt> <dd class="inline">@evt.Metadata.CorrelationId</dd></div>
                            <div><dt class="inline font-medium">Causation id:</dt> <dd class="inline">@evt.Metadata.CausationId</dd></div>
                            <div><dt class="inline font-medium">Actor id:</dt> <dd class="inline">@evt.Metadata.ActorId</dd></div>
                            <div><dt class="inline font-medium">Source:</dt> <dd class="inline">@evt.Metadata.Source</dd></div>
                        </dl>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "correlationId")] public string? LinkedCorrelationId { get; set; }
    private string? lastLinkedId;
    private string? queuedLinkedId;
    protected override async Task OnParametersSetAsync()
    {
        if (LinkedCorrelationId is null || LinkedCorrelationId == lastLinkedId || disposed) return;
        lastLinkedId = LinkedCorrelationId;
        if (busy) { queuedLinkedId = LinkedCorrelationId; return; }
        correlationId = LinkedCorrelationId;
        await OnTraceAsync();
    }

    // The Correlation-ID Tracer: an operator enters a correlation id and sees every event the workflow
    // wrote, across streams and across tenants, oldest first. The page depends on the narrow
    // ICorrelationTracer seam, which owns the parse guard, the sentinel guard, the row cap, and the per-row
    // family classification; the page renders the outcome the seam returns.
    //
    // Each row shows its family, its stream, its scalars, and its tenant without a toggle. The tenant is
    // deliberately always visible: a chain that crosses tenants is an isolation defect, and it is the
    // finding this tool exists to reveal, so an operator must not have to go looking for it. Correlation,
    // causation, actor, and source sit behind the per-row toggle, the Browser's reveal shape.
    //
    // The payload renders as the document the store returned. The trace resolves no CLR payload type
    // (ADR 0043), so what an operator reads here is what the store holds rather than a re-serialization.
    //
    // The page is interactive through the host's global <Routes @rendermode="InteractiveServer" />
    // (App.razor), so it declares no per-page render mode, which would conflict with the inherited one and
    // throw at render. Authorization is the host fallback gate (ADR 0040), upstream of render, so the page
    // has no denied branch.
    private string correlationId = string.Empty;
    private CorrelationTraceView? view;
    private bool error;
    private bool busy;
    private bool focusDetails;
    private ElementReference detailHeading;
    private bool disposed;
    private string? loadedId;
    private readonly CancellationTokenSource lifetime = new();
    private readonly HashSet<int> shownMetadata = [];

    private Task OnSelectedAsync(Guid id)
    {
        if (busy || disposed) return Task.CompletedTask;
        correlationId = id.ToString();
        return OnTraceAsync();
    }

    private async Task OnTraceAsync()
    {
        if (busy || disposed || !Availability.IsAvailable) return;
        busy = true;
        focusDetails = true;
        error = false;
        view = null;
        loadedId = correlationId;
        shownMetadata.Clear();
        try
        {
            var response = await Tracer.TraceCorrelationAsync(loadedId, lifetime.Token);
            if (!disposed) view = response;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception)
        {
            // The existing seam classifies input errors. A read failure remains visible to the operator.
            if (!disposed) error = true;
        }
        finally
        {
            busy = false;
        }
        if (!disposed && queuedLinkedId is { } nextId)
        {
            queuedLinkedId = null;
            correlationId = nextId;
            await OnTraceAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusDetails || busy || disposed) return;
        focusDetails = false;
        try
        {
            // Selecting an id should bring its result into view, including on a phone.
            await detailHeading.FocusAsync();
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (disposed) { }
    }

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;
        lifetime.Cancel();
        lifetime.Dispose();
    }

    private void ToggleMetadata(int index)
    {
        if (!shownMetadata.Remove(index))
        {
            shownMetadata.Add(index);
        }
    }

    private static string KindLabel(TracedEventKind kind)
        => kind == TracedEventKind.ProcessManager ? "Process manager" : "Aggregate";
}
