@page "/audit"
@implements IDisposable
@using EventSourcingCqrs.Domain.Abstractions
@using EventSourcingCqrs.Hosts.AdminConsole.Audit
@using Microsoft.JSInterop
@inject IAuditEventReader Reader
@inject AuditExplorerAvailability Availability

<PageTitle>Audit explorer</PageTitle>

<h1 class="text-3xl font-bold tracking-tight text-slate-900">Audit explorer</h1>
<p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">Inspect recorded events, follow a workflow, and compare its stored facts with the application views.</p>

@if (!Availability.IsAvailable)
{
    <p class="mt-6 rounded-xl border border-slate-200 bg-white p-5 text-sm leading-6 text-slate-600">@Availability.UnavailableReason</p>
}
else
{
    <section aria-label="Audit filters" class="mt-6 rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
        <p class="text-sm font-semibold text-slate-900">All tenants are visible to authorized administrators.</p>
        <p class="mt-2 text-sm leading-6 text-slate-600">Use exact IDs to narrow the results. Leave a filter empty to include every value. The empty actor ID (all zeros) finds system activity and records without an actor.</p>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <label for="audit-stream" class="text-sm font-semibold text-slate-800">Stream ID
                <input id="audit-stream" @bind="streamInput" disabled="@loading" class="@InputClass" placeholder="order: followed by the compact order ID" />
            </label>
            <label for="audit-correlation" class="text-sm font-semibold text-slate-800">Correlation ID
                <input id="audit-correlation" @bind="correlationInput" disabled="@loading" class="@InputClass" />
            </label>
            <label for="audit-tenant" class="text-sm font-semibold text-slate-800">Tenant ID
                <input id="audit-tenant" @bind="tenantInput" disabled="@loading" class="@InputClass" />
            </label>
            <label for="audit-actor" class="text-sm font-semibold text-slate-800">Actor ID
                <input id="audit-actor" @bind="actorInput" disabled="@loading" class="@InputClass" />
            </label>
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
            <button type="button" @onclick="ApplyAsync" disabled="@loading" class="@PrimaryButton">Apply filters</button>
            <button type="button" @onclick="RefreshAsync" disabled="@(loading || page is null || error is not null)" class="@SecondaryButton">Refresh results</button>
        </div>
    </section>

    <section aria-labelledby="audit-results" class="mt-8 min-w-0">
        <h2 id="audit-results" @ref="resultsHeading" tabindex="-1" class="text-xl font-semibold text-slate-900 focus:outline-none">Recorded events</h2>
        @if (loading)
        {
            <p role="status" class="mt-4 text-sm text-slate-600">Loading recorded events...</p>
        }
        else if (error is not null)
        {
            <div role="alert" class="mt-4 rounded-xl border border-red-200 bg-red-50 p-5 text-sm text-red-800">@error</div>
            @if (retryRequest is not null)
            {
                <button type="button" @onclick="RetryAsync" class="mt-4 @SecondaryButton">Retry results</button>
            }
        }
        else if (page is not null)
        {
            <div class="mt-3 space-y-2 text-sm leading-6 text-slate-600">
                <p class="break-all">@FilterSummary(appliedFilter)</p>
                <p>Newest store positions first. Captured upper position: <strong class="text-slate-900">@(page.UpperPosition)</strong>. Refresh results to include newer writes.</p>
                <p>Recorded event time is supplied with the event; it is not a database commit timestamp. An actor ID can be carried from the initiating command and does not prove who executed each later step.</p>
            </div>
            @if (page.Items.Count == 0)
            {
                <p role="status" class="mt-5 rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-600">No recorded events match these filters.</p>
            }
            else
            {
                <div class="mt-5 space-y-4">
                    @foreach (var row in page.Items)
                    {
                        <article @key="row.GlobalPosition" data-audit-position="@row.GlobalPosition" class="min-w-0 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                            <div class="flex flex-wrap items-baseline justify-between gap-2">
                                <h3 class="break-all text-base font-semibold text-slate-900">@row.EventType</h3>
                                <span class="text-sm text-slate-500">Position @row.GlobalPosition</span>
                            </div>
                            <dl class="mt-4 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
                                <div class="min-w-0"><dt class="font-medium text-slate-500">Stream</dt><dd class="mt-1 break-all font-mono text-xs leading-5 text-slate-800">@row.StreamId</dd></div>
                                <div><dt class="font-medium text-slate-500">Stream version / event schema</dt><dd class="mt-1 text-slate-800">@row.StreamVersion / @row.EventVersion</dd></div>
                                <div><dt class="font-medium text-slate-500">Recorded event time</dt><dd class="mt-1 text-slate-800">@row.OccurredUtc.ToString("u")</dd></div>
                                <div class="min-w-0"><dt class="font-medium text-slate-500">Tenant</dt><dd class="mt-1 break-all font-mono text-xs leading-5 text-slate-800">@row.Metadata.Tenant.Value</dd></div>
                                <div class="min-w-0"><dt class="font-medium text-slate-500">Recorded actor</dt><dd class="mt-1 break-all text-slate-800">@(row.Metadata.ActorId == Guid.Empty ? "System or not recorded" : row.Metadata.ActorId.ToString())</dd></div>
                                <div class="min-w-0"><dt class="font-medium text-slate-500">Source</dt><dd class="mt-1 break-all text-slate-800">@(string.IsNullOrWhiteSpace(row.Metadata.Source) ? "Not recorded" : row.Metadata.Source)</dd></div>
                                <div class="min-w-0"><dt class="font-medium text-slate-500">Correlation ID</dt><dd class="mt-1 break-all font-mono text-xs leading-5 text-slate-800">@row.Metadata.CorrelationId</dd></div>
                                <div class="min-w-0"><dt class="font-medium text-slate-500">Event ID</dt><dd class="mt-1 break-all font-mono text-xs leading-5 text-slate-800">@row.EventId</dd></div>
                            </dl>
                            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-teal-700">
                                @if (!row.StreamId.StartsWith("pm-", StringComparison.Ordinal))
                                {
                                    <a href="@($"/streams?streamId={Uri.EscapeDataString(row.StreamId)}")" class="underline underline-offset-4">Inspect stream</a>
                                }
                                @if (row.StreamId.StartsWith("order:", StringComparison.Ordinal))
                                {
                                    <a href="@($"/order-history?streamId={Uri.EscapeDataString(row.StreamId)}")" class="underline underline-offset-4">Compare order history</a>
                                }
                                @if (row.Metadata.CorrelationId != Guid.Empty)
                                {
                                    <a href="@($"/correlations?correlationId={row.Metadata.CorrelationId}")" class="underline underline-offset-4">Trace workflow</a>
                                }
                            </div>
                            <details data-audit-json class="mt-5 border-t border-slate-100 pt-4">
                                <summary class="cursor-pointer text-sm font-semibold text-slate-700">Stored JSON</summary>
                                <p class="mt-3 text-xs leading-5 text-slate-500">The store's JSON rendering, without event upcasting.</p>
                                <h4 class="mt-4 text-sm font-medium text-slate-700">Payload</h4>
                                <pre tabindex="0" aria-label="Stored event payload" class="@JsonClass">@row.PayloadJson</pre>
                                <h4 class="mt-4 text-sm font-medium text-slate-700">Metadata</h4>
                                <pre tabindex="0" aria-label="Stored event metadata" class="@JsonClass">@row.MetadataJson</pre>
                            </details>
                        </article>
                    }
                </div>
            }
        }
        <nav aria-label="Audit result pages" class="mt-6 flex flex-wrap items-center gap-3">
            <button type="button" @onclick="NewerAsync" disabled="@(loading || error is not null || pageIndex == 0)" class="@SecondaryButton">Newer events</button>
            <button type="button" @onclick="OlderAsync" disabled="@(loading || error is not null || page?.NextBeforePosition is null)" class="@SecondaryButton">Older events</button>
            @if (page is not null && !loading && error is null)
            {
                <span class="text-sm text-slate-500">Page @(pageIndex + 1), @(page.Items.Count) @(page.Items.Count == 1 ? "event" : "events")</span>
            }
        </nav>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "streamId")] public string? StreamIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "correlationId")] public string? CorrelationIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "tenantId")] public string? TenantIdQuery { get; set; }
    [SupplyParameterFromQuery(Name = "actorId")] public string? ActorIdQuery { get; set; }

    private const string InputClass = "mt-2 block w-full rounded-lg border border-slate-300 px-3 py-2.5 font-mono text-sm font-normal text-slate-900 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-200 disabled:bg-slate-50";
    private const string PrimaryButton = "rounded-lg bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600 disabled:opacity-50";
    private const string SecondaryButton = "rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600 disabled:opacity-50";
    private const string JsonClass = "mt-2 max-w-full overflow-x-auto rounded-lg bg-slate-950 p-4 font-mono text-xs leading-6 text-slate-100";
    private string streamInput = "", correlationInput = "", tenantInput = "", actorInput = "";
    private (string?, string?, string?, string?) previousQuery;
    private bool initialized, loading, disposed, focusResults;
    private string? error;
    private AuditEventPage? page;
    private AuditEventFilter appliedFilter = new();
    private long?[] cursors = [null];
    private int pageIndex, generation;
    private Request? retryRequest;
    private ElementReference resultsHeading;
    private CancellationTokenSource? pending;
    private readonly CancellationTokenSource lifetime = new();
    private sealed record Request(AuditEventFilter Filter, long? Upper, long? Before, long?[] Cursors, int Index, bool Focus);

    protected override async Task OnParametersSetAsync()
    {
        if (!Availability.IsAvailable || disposed) return;
        var query = (StreamIdQuery, CorrelationIdQuery, TenantIdQuery, ActorIdQuery);
        if (initialized && previousQuery == query) return;
        initialized = true;
        previousQuery = query;
        streamInput = StreamIdQuery ?? "";
        correlationInput = CorrelationIdQuery ?? "";
        tenantInput = TenantIdQuery ?? "";
        actorInput = ActorIdQuery ?? "";
        await ApplyFiltersAsync(false);
    }

    private Task ApplyAsync() => loading || disposed ? Task.CompletedTask : ApplyFiltersAsync(true);

    private async Task ApplyFiltersAsync(bool focus)
    {
        if (!TryFilter(out var filter, out var validation))
        {
            ++generation;
            pending?.Cancel();
            loading = false;
            error = validation;
            retryRequest = null;
            focusResults = focus;
            return;
        }
        await LoadAsync(new(filter, null, null, [null], 0, focus));
    }

    private bool TryFilter(out AuditEventFilter filter, out string? validation)
    {
        filter = new();
        validation = null;
        var stream = string.IsNullOrWhiteSpace(streamInput) ? null : streamInput.Trim();
        if (stream is not null)
        {
            try { _ = StreamId.Parse(stream); }
            catch (ArgumentException) { validation = "Enter a valid stream ID, including its prefix and compact ID segments."; return false; }
        }
        if (!TryOptionalId(correlationInput, out var correlation)) { validation = "Enter a valid correlation ID."; return false; }
        if (!TryOptionalId(tenantInput, out var tenant) || tenant == Guid.Empty) { validation = "Enter a valid, non-empty tenant ID."; return false; }
        if (!TryOptionalId(actorInput, out var actor)) { validation = "Enter a valid actor ID."; return false; }
        filter = new(stream, correlation, tenant is null ? null : TenantId.From(tenant.Value), actor);
        return true;
    }

    private static bool TryOptionalId(string value, out Guid? id)
    {
        id = null;
        if (string.IsNullOrWhiteSpace(value)) return true;
        if (!Guid.TryParse(value.Trim(), out var parsed)) return false;
        id = parsed;
        return true;
    }

    private Task RefreshAsync() => loading || disposed || page is null || error is not null
        ? Task.CompletedTask : LoadAsync(new(appliedFilter, null, null, [null], 0, true));
    private Task NewerAsync() => loading || disposed || error is not null || page is null || pageIndex == 0
        ? Task.CompletedTask : LoadAsync(new(appliedFilter, page.UpperPosition, cursors[pageIndex - 1], cursors, pageIndex - 1, true));
    private Task OlderAsync()
    {
        if (loading || disposed || error is not null || page?.NextBeforePosition is not long before) return Task.CompletedTask;
        var history = cursors.Take(pageIndex + 1).Append((long?)before).ToArray();
        return LoadAsync(new(appliedFilter, page.UpperPosition, before, history, pageIndex + 1, true));
    }
    private Task RetryAsync() => loading || disposed || retryRequest is null ? Task.CompletedTask : LoadAsync(retryRequest);

    private async Task LoadAsync(Request request)
    {
        var currentGeneration = ++generation;
        pending?.Cancel();
        var cancellation = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        pending = cancellation;
        loading = true;
        error = null;
        retryRequest = request;
        focusResults = false;
        try
        {
            var response = await Reader.ReadPageAsync(request.Filter, request.Upper, request.Before, 50, cancellation.Token);
            if (disposed || currentGeneration != generation) return;
            page = response;
            appliedFilter = request.Filter;
            cursors = request.Cursors;
            pageIndex = request.Index;
            retryRequest = null;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception)
        {
            if (!disposed && currentGeneration == generation)
                error = "Unable to load recorded events. Retry the same request or apply different filters.";
        }
        finally
        {
            if (!disposed && currentGeneration == generation)
            {
                loading = false;
                focusResults = request.Focus;
            }
            if (ReferenceEquals(pending, cancellation)) pending = null;
            cancellation.Dispose();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusResults || loading || disposed) return;
        focusResults = false;
        try { await resultsHeading.FocusAsync(); }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (disposed) { }
    }

    private static string FilterSummary(AuditEventFilter filter)
    {
        var selected = new List<string>();
        if (filter.StreamId is not null) selected.Add($"Stream: {filter.StreamId}");
        if (filter.CorrelationId is not null) selected.Add($"Correlation: {filter.CorrelationId}");
        if (filter.Tenant is not null) selected.Add($"Tenant: {filter.Tenant.Value}");
        if (filter.ActorId is not null) selected.Add($"Actor: {filter.ActorId}");
        return selected.Count == 0 ? "All tenants. No filters applied." : "Applied filters: " + string.Join("; ", selected);
    }

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
