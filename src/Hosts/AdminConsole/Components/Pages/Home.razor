@page "/"
@using EventSourcingCqrs.Hosts.AdminConsole.Tracer
@inject CorrelationTracerAvailability Availability

<PageTitle>Operations overview</PageTitle>

<div class="mb-8 max-w-3xl">
    <p class="mb-2 text-sm font-semibold text-teal-700">Operator tools</p>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Operations overview</h1>
    <p class="mt-4 text-base leading-7 text-slate-600">Start with a stream or a correlation id to investigate what happened. Check projection progress to understand what a query can currently show.</p>
</div>

<div class="grid gap-5 md:grid-cols-2">
    <section class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">Recorded facts</p>
        <h2 class="mt-3 text-xl font-semibold">Inspect an event stream</h2>
        <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">Read an aggregate's events in order, inspect the stored payload, and reveal its actor and correlation metadata.</p>
        <a href="/streams" class="mt-6 self-start rounded-md bg-teal-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">Open event browser <span aria-hidden="true">&rarr;</span></a>
    </section>
    <section class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">Across streams</p>
        <h2 class="mt-3 text-xl font-semibold">Trace a workflow</h2>
        @if (Availability.IsAvailable)
        {
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">Follow a correlation id across aggregate and process-manager streams. Keep tenant boundaries visible while you investigate.</p>
            <a href="/correlations" class="mt-6 self-start rounded-md border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">Open correlation tracer <span aria-hidden="true">&rarr;</span></a>
        }
        else
        {
            <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">@Availability.UnavailableReason</p>
            <a href="/correlations" class="mt-6 self-start rounded-md border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">Check tracing availability <span aria-hidden="true">&rarr;</span></a>
        }
    </section>
    <section class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">Read-side progress</p>
        <h2 class="mt-3 text-xl font-semibold">Check projection status</h2>
        <p class="mt-2 flex-1 text-sm leading-6 text-slate-600">Compare each projection's checkpoint with the event-store head. A view can trail a business change that is already committed.</p>
        <a href="/projections" class="mt-6 self-start rounded-md border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">View projection status <span aria-hidden="true">&rarr;</span></a>
    </section>
    <section class="flex flex-col rounded-xl border border-amber-200 bg-amber-50 p-6">
        <p class="text-xs font-semibold uppercase tracking-widest text-amber-800">Recovery action</p>
        <h2 class="mt-3 text-xl font-semibold">Rebuild order throughput</h2>
        <p class="mt-2 flex-1 text-sm leading-6 text-slate-700">Reset and rebuild one tenant's throughput view from its events. You will review the target tenant and confirm before the rebuild starts.</p>
        <a href="/replay" class="mt-6 self-start rounded-md border border-amber-300 bg-white px-4 py-2.5 text-sm font-semibold text-amber-900 hover:bg-amber-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-700">Review rebuild options <span aria-hidden="true">&rarr;</span></a>
    </section>
</div>
