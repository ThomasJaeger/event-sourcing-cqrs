@page "/"
@using EventSourcingCqrs.Hosts.AdminConsole.Tracer
@inject CorrelationTracerAvailability Availability

<PageTitle>Operations overview</PageTitle>

<section class="console-hero" aria-labelledby="operations-heading">
    <div class="console-hero-copy">
        <p class="console-eyebrow"><span class="console-kicker-line" aria-hidden="true"></span>Operations overview</p>
        <h1 id="operations-heading">Make sense of<br /><em>what happened.</em></h1>
        <p class="console-hero-description">Start with an order. Follow its recorded changes, compare its past, and see the state those changes produced.</p>
        <div class="console-hero-topics" aria-label="Investigation paths"><span>Investigate</span><span>Compare</span><span>Recover</span></div>
    </div>
    <figure class="console-hero-art">
        <svg viewBox="0 0 540 335" fill="none" aria-hidden="true" focusable="false">
            <ellipse cx="288" cy="282" rx="203" ry="25" fill="#19172a" opacity=".38"/>
