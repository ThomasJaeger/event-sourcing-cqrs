@page "/replay"
@using EventSourcingCqrs.Domain.Abstractions
@using EventSourcingCqrs.Hosts.AdminConsole.Replay
@inject IOrderThroughputRebuild Rebuild

<PageTitle>Replay Tool</PageTitle>

<h1 class="mb-3 break-words text-3xl font-bold tracking-tight text-slate-900">Replay Tool</h1>

@if (running)
{
    <p role="status" class="rounded-lg border border-teal-200 bg-teal-50 p-5 text-teal-900">Rebuild in progress for tenant <span class="break-all font-mono">@target!.Value</span>. Wait for the result before starting another rebuild.</p>
}
else if (succeeded)
{
    <p role="status" class="rounded-lg border border-teal-200 bg-teal-50 p-5 text-teal-900">Rebuild complete. The order-throughput read model for the tenant was rebuilt.</p>
    <button type="button" @onclick="OnReset"
            class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
        Start another rebuild
    </button>
}
else if (failed)
{
    <p role="alert" class="rounded-lg border border-red-200 bg-red-50 p-5 text-red-800">Rebuild failed. The order-throughput read model may be incomplete. Rerun the rebuild to restore it.</p>
    <button type="button" @onclick="OnReset"
            class="mt-4 rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
        Try again
    </button>
}
else if (confirming)
{
    <div class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
        <p class="mb-5 max-w-3xl text-sm leading-6 text-slate-600">
            Confirm: rebuild the order-throughput read model for tenant <span class="break-all font-mono">@target!.Value</span>. This resets the
            tenant's buckets and replays its events; every other tenant and the global checkpoint are left
            untouched.
        </p>
        <button type="button" @onclick="OnConfirmAsync"
                class="rounded-lg bg-red-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
            Confirm rebuild
        </button>
        <button type="button" @onclick="OnCancel"
                class="ml-2 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600">
            Cancel
        </button>
    </div>
}
else
{
    <div class="rounded-xl border border-slate-200 bg-white p-5 sm:p-6">
        <p class="mb-5 max-w-3xl text-sm leading-6 text-slate-600">
            Rebuild the order-throughput read model for one tenant by replaying that tenant's events. The
            rebuild clears only the named tenant's buckets and leaves every other tenant and the shared
            global checkpoint untouched.
        </p>

        @if (validationError is not null)
        {
            <p role="alert" class="mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-800">@validationError</p>
        }

        <label class="block pb-4">
            <span class="block pb-2 text-sm font-semibold text-slate-800">Tenant id</span>
            <input @bind="tenantId"
                   class="block w-full max-w-2xl rounded-lg border border-slate-300 bg-white px-3 py-2.5 font-mono text-sm text-slate-900 shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-200"
                   placeholder="00000000-0000-0000-0000-000000000000" />
        </label>

        <button type="button" @onclick="OnRebuildClicked"
                class="rounded-lg bg-red-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-red-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">
            Rebuild order-throughput
        </button>
    </div>
}

@code {
    // The Replay Tool: an operator enters a target tenant id and rebuilds the order-throughput read model
    // for it, gated by an explicit confirmation before the destructive rebuild runs. The page is
    // interactive through the host's global <Routes @rendermode="InteractiveServer" /> (App.razor), so it
    // declares no per-page render mode, which would conflict with the inherited one and throw at render.
    //
    // Authorization is the host fallback gate (ADR 0040), upstream of render, so the page has no denied
    // branch. The per-action RebuildProjection check is deferred until an operator role below Admin exists
    // (ADR 0041, Revisit when); today every console operator is an Admin, who holds every permission.
    private string tenantId = string.Empty;
    private TenantId? target;
    private bool confirming;
    private string? validationError;
    private bool running;
    private bool succeeded;
    private bool failed;

    private void OnRebuildClicked()
    {
        if (running) return;
        validationError = null;
        try
        {
            // TenantId.Parse rejects malformed input and the all-zeros GUID with ArgumentException, and
            // there is no TryParse, so the guard is a try/catch around the one validating factory.
            target = TenantId.Parse(tenantId);
        }
        catch (ArgumentException)
        {
            validationError = "Enter a valid tenant id (a GUID).";
            return;
        }
        confirming = true;
    }

    private void OnCancel()
    {
        if (running) return;
        confirming = false;
        target = null;
    }

    private async Task OnConfirmAsync()
    {
        if (running || !confirming || target is null) return;
        running = true;
        confirming = false;
        try
        {
            await Rebuild.RebuildOrderThroughputAsync(target!, CancellationToken.None);
            succeeded = true;
        }
        catch (Exception)
        {
            failed = true;
        }
        finally
        {
            running = false;
        }
    }

    private void OnReset()
    {
        if (running) return;
        succeeded = false;
        failed = false;
        confirming = false;
        target = null;
        validationError = null;
    }
}
