@page "/replay"

<PageTitle>Replay Tool</PageTitle>

<h1 class="text-2xl font-bold p-6">Replay Tool</h1>

<div class="px-6">
    <p class="pb-4 text-gray-700">
        Rebuild the order-throughput read model for one tenant by replaying that tenant's events. The
        rebuild clears only the named tenant's buckets and leaves every other tenant and the shared
        global checkpoint untouched.
    </p>

    <label class="block pb-4">
        <span class="block pb-1 text-sm font-medium text-gray-700">Tenant id</span>
        <input @bind="tenantId"
               class="block w-96 rounded border border-gray-300 px-2 py-1"
               placeholder="00000000-0000-0000-0000-000000000000" />
    </label>

    <button type="button" disabled
            class="rounded bg-red-700 px-4 py-2 text-white disabled:opacity-50">
        Rebuild order-throughput
    </button>
</div>

@code {
    // The Replay Tool's route-and-controls half (Phase 12, ADR 0041): an operator enters a target tenant
    // id and rebuilds the order-throughput read model for it. Authorization is the host fallback gate
    // (ADR 0040), upstream of render, so the page has no denied branch. The rebuild action, its
    // confirmation step, and the per-action permission gate are a later commit; here the button renders
    // disabled and the controls are static until that action lands.
    private string tenantId = string.Empty;
}
