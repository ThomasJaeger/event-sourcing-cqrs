@page "/projections"
@using EventSourcingCqrs.Projections.Infrastructure
@inject ProjectionLagReader Reader

<PageTitle>Projection Status</PageTitle>

<h1 class="mb-3 break-words text-3xl font-bold tracking-tight text-slate-900">Projection Status</h1>
<p class="mb-6 max-w-3xl text-sm leading-6 text-slate-600">Compare recorded progress with the event-store head. Positions behind is a position gap, not a count of missing events.</p>

@if (error)
{
    <p role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">Unable to load projection status.</p>
}
else if (rows is { Count: 0 })
{
    <p role="status" class="rounded-lg border border-slate-200 bg-white p-5 text-slate-600">No projections registered.</p>
}
else if (rows is not null)
{
    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-600" role="region" aria-label="Projection progress" tabindex="0">
    <table class="w-full min-w-max text-sm">
        <caption class="sr-only">Projection checkpoints and event-store head positions</caption>
        <thead class="bg-slate-100 text-slate-700">
            <tr>
                <th scope="col" class="px-3 py-4 text-left font-semibold sm:px-5">Projection</th>
                <th scope="col" class="px-3 py-4 text-left font-semibold sm:px-5">Positions Behind</th>
                <th scope="col" class="px-3 py-4 text-left font-semibold sm:px-5">Head</th>
                <th scope="col" class="px-3 py-4 text-left font-semibold sm:px-5">Checkpoint</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var row in rows)
            {
                <tr>
                    <td class="px-3 py-4 font-mono text-xs text-slate-700 sm:px-5">@row.ProjectionName</td>
                    <td class="px-3 py-4 font-mono text-xs text-slate-700 sm:px-5">@row.PositionsBehind</td>
                    <td class="px-3 py-4 font-mono text-xs text-slate-700 sm:px-5">@row.HeadPosition</td>
                    <td class="px-3 py-4 font-mono text-xs text-slate-700 sm:px-5">@row.CheckpointPosition</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    // The projection-lag read for an operator: the head of the event stream minus each projection's
    // checkpoint. The reader is the concrete owned leaf (no interface), composed focused so the console
    // carries no write stack. The read runs once on initialization inside a try/catch: ReadAsync touches
    // two databases, so a failure is a real operational state, surfaced as an operator-visible error
    // rather than a blank page or an escaping exception. Authorization is the host fallback gate
    // (ADR 0040), upstream of render, so the page has no denied branch.
    private IReadOnlyList<ProjectionLag>? rows;
    private bool error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rows = await Reader.ReadAsync(CancellationToken.None);
        }
        catch (Exception)
        {
            error = true;
        }
    }
}
