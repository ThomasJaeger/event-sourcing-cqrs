@inherits LayoutComponentBase

<div class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <a href="#main-content" class="sr-only rounded-md bg-white px-4 py-3 font-semibold text-teal-900 shadow-lg focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:outline focus:outline-2 focus:outline-teal-600">Skip to content</a>
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-start justify-between gap-3 pb-5">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">Event Sourcing &amp; CQRS</p>
                    <a href="/" class="mt-1 inline-block rounded text-xl font-bold tracking-tight text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal-600">Operations console</a>
                </div>
                <p class="max-w-xs text-sm leading-6 text-slate-500">Event history and projection recovery</p>
            </div>
            <nav aria-label="Operator tools" class="flex flex-wrap gap-x-2 gap-y-1 pb-2">
                <NavLink href="/" Match="NavLinkMatch.All" class="rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-600" ActiveClass="bg-teal-50 font-bold underline decoration-2 underline-offset-4">Overview</NavLink>
                <NavLink href="/streams" class="rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-600" ActiveClass="bg-teal-50 font-bold underline decoration-2 underline-offset-4">Event streams</NavLink>
                <NavLink href="/correlations" class="rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-600" ActiveClass="bg-teal-50 font-bold underline decoration-2 underline-offset-4">Correlation trace</NavLink>
                <NavLink href="/projections" class="rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-600" ActiveClass="bg-teal-50 font-bold underline decoration-2 underline-offset-4">Projection status</NavLink>
                <NavLink href="/replay" class="rounded-md px-3 py-2 text-sm text-slate-700 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-600" ActiveClass="bg-teal-50 font-bold underline decoration-2 underline-offset-4">Rebuild a view</NavLink>
            </nav>
        </div>
    </header>
    <main id="main-content" tabindex="-1" class="mx-auto w-full min-w-0 max-w-7xl flex-1 px-4 py-8 focus:outline-none sm:px-6 lg:px-8">
        @Body
    </main>
    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-5 text-xs leading-5 text-slate-500 sm:px-6 lg:px-8">Operations console</div>
    </footer>
</div>
